# rfdiffusion3's apex wheel, compiled OFFLINE: this image holds everything the compile needs (the pinned torch stack, the CUDA 13.0 compiler,
# the apex source at the pinned commit, ninja), downloaded at build time — so build it on a node WITH internet, then run the compile on a
# node WITHOUT (no GPU needed). Mirrors the `WHEELS_FROM=build` branch of rfdiffusion3/environment/Dockerfile step for step.
#   apptainer build --fakeroot apex_builder.sif tools/rfd3_apex/apex_builder.def        # login node, from the repo root
#   apptainer run apex_builder.sif <out_dir> [jobs]                                    # compute node: writes <out_dir>/<apex wheel>
Bootstrap: docker
From: nvidia/cuda:12.8.1-runtime-ubuntu22.04

%files
    rfdiffusion3/environment/requirements.lock /opt/build-in/requirements.lock
    rfdiffusion3/stock/PINS.json /opt/build-in/PINS.json

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential
    curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20240107/cpython-3.12.1+20240107-x86_64_v3-unknown-linux-gnu-install_only.tar.gz"
    echo "a7bcc6c9f66dbd47ea99615f30f101c5d2dd0084ca333d2f7336e64050951338  /tmp/python.tar.gz" | sha256sum -c -
    tar -xzf /tmp/python.tar.gz -C /tmp && cp -RLp /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz
    ln -sf /usr/local/bin/python3 /usr/local/bin/python
    # the same torch stack the kit's /opt/stock venv gets (apex compiles against it)
    grep -v -E '^(#|apex==|rc-foundry==)' /opt/build-in/requirements.lock > /opt/build-in/stack.txt
    python -m venv /opt/stock
    /opt/stock/bin/python -m pip install --no-cache-dir --no-deps "$(grep -E '^pip==' /opt/build-in/stack.txt)"
    /opt/stock/bin/python -m pip install --no-cache-dir --no-deps -r /opt/build-in/stack.txt
    # CUDA 13.0 compiler + headers (the Dockerfile's list)
    apt-get install -y --no-install-recommends cuda-nvcc-13-0 cuda-cudart-dev-13-0 cuda-nvrtc-dev-13-0 cuda-profiler-api-13-0 cuda-nvml-dev-13-0 \
        libcublas-dev-13-0 libcurand-dev-13-0 libcusparse-dev-13-0 libcusolver-dev-13-0
    rm -rf /var/lib/apt/lists/*
    # apex source at the pinned commit (same sha256 as the Dockerfile) + ninja
    eval "$(python -c "import json; p = json.load(open('/opt/build-in/PINS.json')); a = p['pinned_stack']['apex']; print('APEX_WHEEL=%s APEX_REPO=%s APEX_COMMIT=%s' % (a['wheel'], a['repo'], a['commit']))")"
    curl -fsSL -o /tmp/apex.tar.gz "$APEX_REPO/archive/$APEX_COMMIT.tar.gz"
    echo "f3cc6e36d357f5c47e39fe6f7ab7282ec7fc19af0b4a8425758ec2f2c6cc038e  /tmp/apex.tar.gz" | sha256sum -c -
    mkdir -p /opt/apex-src && tar -xzf /tmp/apex.tar.gz -C /opt/apex-src && rm -f /tmp/apex.tar.gz
    /opt/stock/bin/python -m pip install --no-cache-dir --target /opt/buildtools ninja==1.13.0
    printf 'APEX_WHEEL=%s\nAPEX_COMMIT=%s\n' "$APEX_WHEEL" "$APEX_COMMIT" > /opt/apex.env
    rm -rf /root/.cache /opt/build-in

%runscript
    set -e
    out="${1:?usage: apptainer run apex_builder.sif <out_dir> [jobs]}"; J="${2:-$(nproc)}"
    . /opt/apex.env
    mkdir -p "$out"
    work="$(mktemp -d "${TMPDIR:-/tmp}/apex-build.XXXXXX")"; trap 'rm -rf "$work"' EXIT
    cp -a "/opt/apex-src/apex-$APEX_COMMIT" "$work/src"          # the image is read-only; compile in a scratch copy
    P=$(( J < 8 ? J : 8 )); MJ=$(( J / P )); [ "$MJ" -gt 0 ] || MJ=1
    echo "apex $APEX_COMMIT: $J jobs ($P extensions at a time, $MJ ninja jobs each), TORCH_CUDA_ARCH_LIST=8.0;9.0+PTX -> $out/$APEX_WHEEL"
    cd "$work/src"
    PYTHONPATH=/opt/buildtools PATH=/opt/buildtools/bin:/usr/local/cuda-13.0/bin:$PATH CUDA_HOME=/usr/local/cuda-13.0 CC=gcc CXX=g++ \
    APEX_CPP_EXT=1 APEX_CUDA_EXT=1 APEX_PARALLEL_BUILD=$P MAX_JOBS=$MJ CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J NVCC_APPEND_FLAGS="--threads 4" TORCH_CUDA_ARCH_LIST="8.0;9.0+PTX" \
        /opt/stock/bin/python -m pip wheel --no-deps --no-build-isolation --no-cache-dir -w "$out" .
    ls -la "$out/$APEX_WHEEL" && sha256sum "$out/$APEX_WHEEL"
