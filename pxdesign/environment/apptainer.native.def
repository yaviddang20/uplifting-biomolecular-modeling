# GENERATED by tools/docker2apptainer.py from pxdesign/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh pxdesign          # or: mkdir -p _jitcache && apptainer build [--fakeroot] pxdesign.sif pxdesign/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# PXDesign optimization kit — Apptainer / Singularity image made FROM the container image of pxdesign/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged pxdesign-kit:dev in the local Docker daemon (build
# it first: `docker build -f pxdesign/environment/Dockerfile -t pxdesign-kit:dev .` from the bundle's top directory); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/pxdesign-kit:<tag>`.
#   apptainer build pxdesign.sif pxdesign/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/pxdesign_data:/weights --env PXDESIGN_CKPT_DIR=/weights/checkpoint --env PROTENIX_DATA_ROOT_DIR=/weights/ccd_cache \
#     --bind "$PWD/out":/out pxdesign.sif warm --config h100 --mode fast --out_dir /out/warm
# The image is read-only: give every verb an --out_dir on a bound, writable path (stock's LayerNorm CUDA extension is compiled inside the image,
# so no verb needs to write beside the installed packages); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned
# stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.1.1-devel-ubuntu22.04

%arguments
    BUILD_JOBS=0

%files
    common /.ctx/common
    pxdesign /.ctx/pxdesign

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl git build-essential \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -a /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    _copy /.ctx/pxdesign/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
grep -v '^#' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps --src /opt -r /tmp/stack.txt \
 && rm /tmp/stack.txt /tmp/requirements.lock \
 && rm -rf /opt/pxdesign/.git \
 && rm /opt/pxdesign/pxdesign/pxd_server/Helvetica-Regular.ttf /opt/pxdesign/pxdesign/pxd_server/TimesNewRoman.ttf
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
J=${BUILD_JOBS:-0}; [ "$J" -gt 0 ] || J=$(nproc --all); echo "compiling stock's LayerNorm CUDA extension: $J jobs on $(nproc --all) cores" \
 && MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J NVCC_THREADS=4 \
    python -c "import os, protenix.model.layer_norm.layer_norm as m; p = os.path.join(os.path.dirname(m.__file__), 'fastfold_layer_norm_cuda.so'); assert os.path.isfile(p), p; print('compiled', p)"
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/pxdesign /kit/pxdesign
    mkdir -p /kit/pxdesign && cd /kit/pxdesign
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
bash run.sh install
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/pxdesign && exec bash /kit/pxdesign/run.sh "$@"

%help
    PXDesign optimization kit: drop-in modes that make stock PXDesign binder design (pxdesign 0.1.0 on protenix 0.5.0+pxd) faster and lighter
    on GPU memory without changing how it is called — off = stock exactly; exact = identical outputs under the deterministic recipe, faster;
    fast = small documented numeric differences, faster still (the default); big = lowest memory. `apptainer run --nv pxdesign.sif <verb> ...`
    = `bash /kit/pxdesign/run.sh <verb> ...` (verbs: install, design, check, warm; /kit/pxdesign/README.md inside the image). Requires an NVIDIA
    driver that runs CUDA 12.1 (525.60 or newer), PXDESIGN_CKPT_DIR naming the checkpoint directory and PROTENIX_DATA_ROOT_DIR the CCD cache.

