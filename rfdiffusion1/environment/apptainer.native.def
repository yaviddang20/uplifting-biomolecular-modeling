# GENERATED by tools/docker2apptainer.py from rfdiffusion1/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh rfdiffusion1          # or: mkdir -p _jitcache && apptainer build [--fakeroot] rfdiffusion1.sif rfdiffusion1/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# RFdiffusion-1 optimization kit — Apptainer / Singularity image made FROM the container image of rfdiffusion1/environment/Dockerfile: the same
# stack, the same /opt/rfd checkout and the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged
# rfdiffusion1-kit:dev in the local Docker daemon (build it first with that Dockerfile, whose header has the command); for a published tag the two header lines read
# `Bootstrap: docker` / `From: <registry>/rfdiffusion1-kit:<tag>`.
#   apptainer build rfdiffusion1.sif rfdiffusion1/environment/apptainer.def
#   T=opt/forward/fast_inference/inputs_public/insulin_target.pdb      (a bundled example target; %runscript runs from /kit/rfdiffusion1, so kit-relative paths resolve)
#   apptainer run --nv --cleanenv --writable-tmpfs --bind /path/to/rfd_weights:/weights --env WEIGHTS=/weights --bind "$PWD/out":/kit/rfdiffusion1/out \
#     rfdiffusion1.sif design --config h100 --mode fast inference.input_pdb=$T \
#     'contigmap.contigs=[A1-115/0 80-80]' 'ppi.hotspot_res=[A59,A83,A91]' inference.num_designs=4 inference.output_prefix=out/fast/des
# The image is read-only: outputs go under a bound, writable path (out/ above; relative paths resolve from /kit/rfdiffusion1), and
# --writable-tmpfs takes what stock RFdiffusion writes beside its own files — Hydra's run log (outputs/ under the working directory, `--mode off`);
# its IGSO(3) schedule cache (first run only) goes to ${TMPDIR:-/tmp}/rfdiffusion1_schedules-uid<uid>, which `design` and `warm` pass to upstream
# because /opt/rfd/schedules is root's (opt/rfdiffusion1_opt/schedules.py); the Triton cache of `fast` goes under $HOME/.cache
# (bound by default). %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    rfdiffusion1 /.ctx/rfdiffusion1

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -a /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V && echo "build machine cores: $(nproc --all)"
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/rfdiffusion1/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
python -m pip install --no-cache-dir --no-deps -r /tmp/requirements.lock && rm -f /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
printf 'setuptools==84.0.0\n' > /usr/local/share/pip-build-constraints.txt
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/rfdiffusion1/stock/rfdiffusion-86507b65.tar.gz /tmp/stock/rfdiffusion-86507b65.tar.gz
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
mkdir -p /opt && tar -xzf /tmp/stock/rfdiffusion-86507b65.tar.gz -C /opt && mv /opt/rfdiffusion-86507b65 /opt/rfd && rm -rf /tmp/stock \
 && export PIP_CONSTRAINT=/usr/local/share/pip-build-constraints.txt \
 && python3.11 -m pip install --no-cache-dir --no-deps /opt/rfd/env/SE3Transformer \
 && python3.11 -m pip install --no-cache-dir --no-deps -e /opt/rfd \
 && mkdir -m 755 /opt/rfd/schedules
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/common/mps_packing /kit/common/mps_packing
    _copy /.ctx/rfdiffusion1 /kit/rfdiffusion1
    mkdir -p /kit/rfdiffusion1 && cd /kit/rfdiffusion1
    cat > /tmp/.run6.sh <<'__DOCKER_RUN_6__'
PIP_CONSTRAINT=/usr/local/share/pip-build-constraints.txt bash run.sh install
__DOCKER_RUN_6__
    /bin/sh /tmp/.run6.sh || { echo 'RUN step 6 failed' >&2; exit 1; }; rm -f /tmp/.run6.sh
    _copy /.ctx/rfdiffusion1/environment/Dockerfile /.ctx/_jitcache/rfdiffusion1-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run7.sh <<'__DOCKER_RUN_7__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_7__
    /bin/sh /tmp/.run7.sh || { echo 'RUN step 7 failed' >&2; exit 1; }; rm -f /tmp/.run7.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export CC="gcc"
    export CXX="g++"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export CC="gcc"
    export CXX="g++"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/rfdiffusion1 && exec bash /kit/rfdiffusion1/run.sh "$@"

%help
    RFdiffusion-1 optimization kit: drop-in modes that make stock RFdiffusion 1.1.0 (RosettaCommons/RFdiffusion @ 86507b65) faster on one
    GPU without changing its inputs, sampler settings or output files — off = the stock command line; exact = the same output bytes at the same
    seed, faster; fast = small documented numeric differences, faster still. `apptainer run --nv rfdiffusion1.sif <verb> ...` =
    `bash /kit/rfdiffusion1/run.sh <verb> ...` (verbs: install, design, check, warm; /kit/rfdiffusion1/README.md inside the image). Requires an
    NVIDIA driver that runs CUDA 12.4 (550 or newer) and WEIGHTS naming the directory that holds Complex_base_ckpt.pt.

