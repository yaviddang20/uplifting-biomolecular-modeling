# GENERATED by tools/docker2apptainer.py from caliby/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh caliby          # or: mkdir -p _jitcache && apptainer build [--fakeroot] caliby.sif caliby/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Caliby optimization kit — Apptainer / Singularity image made FROM the container image of caliby/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged caliby-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup', route A); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/caliby-kit:<tag>`.
#   apptainer build caliby.sif caliby/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/model_params:/weights --env MODEL_PARAMS_DIR=/weights --bind "$PWD/out":/out caliby.sif \
#     design --config h100 --mode fast --input /kit/caliby/opt/forward/xattempt_addon/tests/public_inputs/7xhz.cif --out_dir /out/fast --seed 0
# The image is read-only: give every verb an --out_dir on a bound, writable path; the Triton cache and warm's scratch outputs go under $HOME
# (bound by default: ~/.triton, ~/.cache/caliby_opt); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack,
# --cleanenv keeps the host's variables out.
Bootstrap: docker
From: python:3.12.10-slim-bookworm

%files
    _jitcache /.ctx/_jitcache
    caliby /.ctx/caliby
    common /.ctx/common

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export HF_HUB_OFFLINE="1"
    export WANDB_MODE="disabled"
    export PDB_MIRROR_PATH=""
    export CCD_MIRROR_PATH=""
    _copy /.ctx/caliby/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/caliby/stock/caliby-41d31560.tar.gz /.ctx/caliby/stock/atomworks-caliby-ea2c998a.tar.gz /.ctx/caliby/stock/protpardelle-1c-7962da09.tar.gz /tmp/stock/
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
grep -E '^(pip|setuptools|wheel)==' /tmp/requirements.lock > /tmp/installers.txt \
 && grep -v -E '^#|^(pip|setuptools|wheel)==| @ git\+' /tmp/requirements.lock > /tmp/stack.txt \
 && python3.12 -m pip install --no-cache-dir --no-deps -r /tmp/installers.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/atomworks-caliby-ea2c998a.tar.gz /tmp/stock/protpardelle-1c-7962da09.tar.gz /tmp/stock/caliby-41d31560.tar.gz \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/installers.txt /tmp/requirements.lock
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/caliby /kit/caliby
    mkdir -p /kit/caliby && cd /kit/caliby
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
bash run.sh install
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/caliby/environment/Dockerfile /.ctx/_jitcache/caliby-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export HF_HUB_OFFLINE="1"
    export WANDB_MODE="disabled"
    export PDB_MIRROR_PATH=""
    export CCD_MIRROR_PATH=""
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/caliby && exec bash /kit/caliby/run.sh "$@"

%help
    Caliby optimization kit: drop-in modes that make stock Caliby (caliby 0.1 @ 41d31560, SolubleCaliby weights) design sequences faster
    without changing how it is called — one variant per process, single (the default) or ensemble32; off = stock exactly; fast (single's kit
    mode) = faster and deterministic; exact (ensemble32's kit mode) = identical outputs, faster.
    `apptainer run --nv caliby.sif <verb> ...` = `bash /kit/caliby/run.sh <verb> ...` (verbs: install, design, check, warm; /kit/caliby/README.md
    inside the image). Requires an NVIDIA driver that runs CUDA 12.4 (550 or newer) and MODEL_PARAMS_DIR naming the weights root.

