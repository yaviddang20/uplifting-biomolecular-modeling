# GENERATED by tools/docker2apptainer.py from flashzoi/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh flashzoi          # or: mkdir -p _jitcache && apptainer build [--fakeroot] flashzoi.sif flashzoi/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Flashzoi optimization kit — Apptainer / Singularity image made FROM the container image of flashzoi/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged flashzoi-kit:dev in the local Docker daemon (build
# it first: README.md 'Setup', route A); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/flashzoi-kit:<tag>`.
#   apptainer build flashzoi.sif flashzoi/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /data/weights/flashzoi/hf:/weights --env FLASHZOI_WEIGHTS=/weights --bind "$PWD/in":/in --bind "$PWD/out":/out \
#     flashzoi.sif pred --config h100 --mode exact --input /in --out /out/exact
# The image is read-only: give every pred an --out on a bound, writable path; the Triton JIT cache goes under $HOME/.triton (bound by default)
# unless MODEL_OPT_JIT_ROOT / TRITON_CACHE_DIR name another bound path; %environment keeps a host user site-packages (PEP 370) from shadowing the
# pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: python:3.11.12-slim-bookworm

%files
    _jitcache /.ctx/_jitcache
    flashzoi /.ctx/flashzoi

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/flashzoi/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/flashzoi/stock/borzoi_pytorch-0.5.1-py3-none-any.whl /tmp/stock/borzoi_pytorch-0.5.1-py3-none-any.whl
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
grep -E '^(pip|wheel|uv)==' /tmp/requirements.lock > /tmp/tools.txt \
 && python3.11 -m pip install --no-cache-dir --no-deps -r /tmp/tools.txt \
 && grep -v -E '^(#|borzoi-pytorch==)' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/borzoi_pytorch-0.5.1-py3-none-any.whl \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/tools.txt /tmp/requirements.lock
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/flashzoi /kit/flashzoi
    mkdir -p /kit/flashzoi && cd /kit/flashzoi
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
bash run.sh install
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/flashzoi/environment/Dockerfile /.ctx/_jitcache/flashzoi-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/flashzoi && exec bash /kit/flashzoi/run.sh "$@"

%help
    Flashzoi optimization kit: drop-in modes that make stock Flashzoi (borzoi-pytorch 0.5.1) faster without changing how it is called —
    off = stock exactly; exact = identical outputs, faster (the default). `apptainer run --nv flashzoi.sif <verb> ...`
    = `bash /kit/flashzoi/run.sh <verb> ...` (verbs: install, pred, check, warm; /kit/flashzoi/README.md inside the image). Requires an NVIDIA
    driver that runs CUDA 12.4 (550 or newer), an H100/H200 (configs/h100.env) or A100 (configs/a100.env), and FLASHZOI_WEIGHTS naming the weights' hub cache.

