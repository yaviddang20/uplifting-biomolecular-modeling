# GENERATED by tools/docker2apptainer.py from esmc/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh esmc          # or: mkdir -p _jitcache && apptainer build [--fakeroot] esmc.sif esmc/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# ESM C optimization kit — Apptainer / Singularity image made FROM the container image of esmc/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged esmc-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup', route A); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/esmc-kit:<tag>`.
#   apptainer build esmc.sif esmc/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/weights:/weights --env HF_HOME=/weights/hf --env HF_HUB_OFFLINE=1 esmc.sif check --variant 6b
#   apptainer exec --nv --cleanenv --bind /path/to/weights:/weights --env HF_HOME=/weights/hf --env ESMC_OPT=exact --bind "$PWD":/work esmc.sif \
#     python /work/your_script.py                     # your own ESM C code with the kit on (README.md 'Run'); ESMC_OPT unset = stock
# The image is read-only: write outputs to a bound path; the JIT caches go under $HOME (bound by default) unless TRITON_CACHE_DIR names a bound path. $HOME is
# the invoking user's bound home, so the image's prebuilt extension cache (/root/.cache/esmc_sdkfused) is not on the lookup path: the first kit-mode
# load per user builds the extension once (nvcc and ninja are in the image) into ~/.cache/esmc_sdkfused on the host and later runs import it; keep
# the home bind or bind a persistent directory over ~/.cache; root may pass --no-home to use the image's copy. %environment keeps a
# host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:13.0.1-runtime-ubuntu24.04

%arguments
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    esmc /.ctx/esmc

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64"
    export HF_HUB_OFFLINE="1"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl git build-essential clang \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/astral-sh/python-build-standalone/releases/download/20240107/cpython-3.12.1+20240107-x86_64_v3-unknown-linux-gnu-install_only.tar.gz" \
 && echo "a7bcc6c9f66dbd47ea99615f30f101c5d2dd0084ca333d2f7336e64050951338  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -RL --preserve=mode,timestamps /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    _copy /.ctx/esmc/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
J=${BUILD_JOBS:-0}; [ "$J" -gt 0 ] || J=$(nproc --all); export MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J; echo "build jobs: $J (cores: $(nproc --all))" \
 && echo "setuptools==84.0.0" > /tmp/build-constraints.txt \
 && PIP_CONSTRAINT=/tmp/build-constraints.txt python -m pip install --no-cache-dir --no-deps -r /tmp/requirements.lock \
 && rm -f /tmp/build-constraints.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends cuda-nvcc-13-0 ninja-build \
 && rm -rf /var/lib/apt/lists/* && /usr/local/cuda/bin/nvcc --version | tail -1
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/esmc /kit/esmc
    mkdir -p /kit/esmc && cd /kit/esmc
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
bash run.sh install
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    _copy /.ctx/esmc/environment/Dockerfile /.ctx/_jitcache/esmc-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run6.sh <<'__DOCKER_RUN_6__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_6__
    /bin/sh /tmp/.run6.sh || { echo 'RUN step 6 failed' >&2; exit 1; }; rm -f /tmp/.run6.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64"
    export HF_HUB_OFFLINE="1"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/esmc && exec bash /kit/esmc/run.sh "$@"

%help
    ESM C optimization kit: drop-in modes that make stock ESM C (Biohub esm 3.4.0, sizes 300m / 600m / 6b) faster through the SDK route
    without changing its outputs — off = stock exactly; exact = identical outputs, faster (the default). `apptainer run --nv esmc.sif <verb> ...`
    = `bash /kit/esmc/run.sh <verb> ...` (verbs: install, check; `apptainer exec ... python your_script.py` with ESMC_OPT=exact runs your own
    code with the kit on; /kit/esmc/README.md inside the image). Requires an NVIDIA driver
    that runs CUDA 13.0 (580 or newer) and HF_HOME naming the weights.

