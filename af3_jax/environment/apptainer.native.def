# GENERATED by tools/docker2apptainer.py from af3_jax/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh af3_jax          # or: mkdir -p _jitcache && apptainer build [--fakeroot] af3_jax.sif af3_jax/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# AlphaFold 3 (JAX) optimization kit — Apptainer / Singularity image made FROM the container image of af3_jax/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged af3_jax-kit:dev in the local Docker daemon (build it first:
# README.md Setup).
#   apptainer build af3_jax.sif af3_jax/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/af3_params:/params --env AF3_JAX_PARAMS_ROOT=/params --bind /path/to/af3_cache:/cache \
#     --env AF3_JAX_CACHE_ROOT=/cache --bind "$PWD/inputs":/inputs --bind "$PWD/out":/out af3_jax.sif \
#     pred --config h100 --variant p2 --mode fast --input_dir /inputs --output_dir /out/fast
# The image is read-only: give every verb an --output_dir and a cache root (AF3_JAX_CACHE_ROOT; `warm` fills it, `pred` reads it) on bound, writable paths;
# %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.6.3-base-ubuntu24.04

%arguments
    WHEELS_FROM=build
    STOCK_WHEEL_SHA256=
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    af3_jax /.ctx/af3_jax
    common /.ctx/common

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update --quiet \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --quiet git wget curl ca-certificates gcc g++ make zlib1g-dev zstd patch \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20240107/cpython-3.12.1+20240107-x86_64_v3-unknown-linux-gnu-install_only.tar.gz" \
 && echo "a7bcc6c9f66dbd47ea99615f30f101c5d2dd0084ca333d2f7336e64050951338  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -RL --preserve=mode,timestamps /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python3 -V \
 && python3 -m pip install --no-cache-dir uv==0.9.24
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export CC="/usr/bin/gcc"
    export CXX="/usr/bin/g++"
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_PYTHON_CLIENT_PREALLOCATE="true"
    export XLA_CLIENT_MEM_FRACTION="0.95"
    export WHEELS_FROM="{{ WHEELS_FROM }}"
    export STOCK_WHEEL_SHA256="{{ STOCK_WHEEL_SHA256 }}"
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    export PATH="/alphafold3_venv/bin:$PATH"
    _copy /.ctx/af3_jax/environment/requirements.lock /tmp/stock/
    _copy /.ctx/af3_jax/stock /tmp/stock/tree
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
uv venv --python /usr/local/bin/python3.12 /alphafold3_venv \
 && grep -v -E '^(torch|sympy)([ =@]|$)' /tmp/stock/requirements.lock > /tmp/stock/upstream.lock && grep -E '^(torch|sympy)([ =@]|$)' /tmp/stock/requirements.lock > /tmp/stock/converter.lock \
 && uv pip install --python /alphafold3_venv/bin/python3 --no-cache --no-deps -r /tmp/stock/upstream.lock \
 && uv pip install --python /alphafold3_venv/bin/python --no-cache --no-deps -r /tmp/stock/converter.lock \
 && bash /tmp/stock/tree/unpack_src.sh /app/alphafold \
 && if [ "$WHEELS_FROM" = build ]; then J=${BUILD_JOBS:-0}; [ "$J" -gt 0 ] || J=$(nproc --all); echo "stock wheel: compiling with $J parallel jobs ($(nproc --all) cores here)"; export MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J; \
      cp -a /app/alphafold /tmp/af3src && uv build --wheel --python /usr/local/bin/python3.12 --out-dir /tmp/stock/tree/wheels /tmp/af3src && rm -rf /tmp/af3src /root/.cache; \
    elif [ "$WHEELS_FROM" != prebuilt ]; then echo "WHEELS_FROM=$WHEELS_FROM: build or prebuilt" >&2; exit 2; fi \
 && python3 -c "import hashlib, json, os, sys; w = json.load(open('/tmp/stock/tree/PINS.json'))['upstream']['wheel']; p = '/tmp/stock/tree/wheels/' + w['file']; route = os.environ.get('WHEELS_FROM', 'build'); own = os.environ.get('STOCK_WHEEL_SHA256', ''); os.path.isfile(p) or sys.exit(w['file'] + ' is not in af3_jax/stock/wheels/: fetch the tested wheel there first (README.md Install), or build with WHEELS_FROM=build'); h = hashlib.sha256(open(p, 'rb').read()).hexdigest(); built = route == 'build'; ok = built or h == (own or w['sha256']); print('stock wheel ' + w['file'] + ': sha256 ' + h + (' — compiled from af3_jax/stock/ in this build (stock/PINS.json upstream.wheel, ' + w['sha256'][:16] + '..., describes the tested wheel; a source build never repeats its bytes)' if built else ' = STOCK_WHEEL_SHA256, a wheel of your own build (stock/PINS.json upstream.wheel describes the tested one)' if own else ' = stock/PINS.json upstream.wheel, the tested build') if ok else w['file'] + ': sha256 ' + h + ' is not ' + ('STOCK_WHEEL_SHA256=' + own if own else 'the pin ' + w['sha256'] + ' (stock/PINS.json upstream.wheel) — a wheel you built yourself takes --build-arg STOCK_WHEEL_SHA256=<its sha256>'), file=sys.stderr); sys.exit(0 if ok else 1)" \
 && uv pip install --python /alphafold3_venv/bin/python3 --no-cache --no-deps /tmp/stock/tree/wheels/alphafold3_open-3.1.4-cp312-cp312-linux_x86_64.whl \
 && build_data \
 && rm -rf /tmp/stock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/af3_jax /kit/af3_jax
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
/usr/local/bin/python3.12 -m venv /kit/venv
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    export PATH="/kit/venv/bin:$PATH"
    mkdir -p /kit/af3_jax && cd /kit/af3_jax
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
bash run.sh install \
 && python -c "from af3_jax_opt.cli import ensure_fast_script; r = ensure_fast_script(); print('[af3-jax-opt install]', r['path'], r['state'])" \
 && rm -f /kit/af3_jax/stock/wheels/*.whl
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    _copy /.ctx/af3_jax/environment/Dockerfile /.ctx/_jitcache/af3_jax-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run6.sh <<'__DOCKER_RUN_6__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_6__
    /bin/sh /tmp/.run6.sh || { echo 'RUN step 6 failed' >&2; exit 1; }; rm -f /tmp/.run6.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export CC="/usr/bin/gcc"
    export CXX="/usr/bin/g++"
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_PYTHON_CLIENT_PREALLOCATE="true"
    export XLA_CLIENT_MEM_FRACTION="0.95"
    export PATH="/alphafold3_venv/bin:$PATH"
    export PATH="/kit/venv/bin:$PATH"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/af3_jax && exec bash /kit/af3_jax/run.sh "$@"

%help
    AlphaFold 3 (JAX) optimization kit: drop-in modes that make the AlphaFold 3 open inference code (the sokrypton/alphafold3 fork at tag v3.1.4) faster,
    or lighter on GPU memory, when it runs the converted OpenFold3-preview2 weights (variant p2) — off = stock exactly; exact = identical outputs, faster;
    fast = small documented numeric differences, faster still (the default); big = lowest memory for large inputs. `apptainer run --nv af3_jax.sif
    <verb> ...` = `bash /kit/af3_jax/run.sh <verb> ...` (verbs: install, pred, check, warm; /kit/af3_jax/README.md inside the image). Requires an NVIDIA
    driver that runs CUDA 12 (550 or newer), AF3_JAX_PARAMS_ROOT naming the converted parameters (`install --weights DIR` makes them) and, for the kit
    modes, AF3_JAX_CACHE_ROOT naming a writable cache root.

