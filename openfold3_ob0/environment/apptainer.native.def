# GENERATED by tools/docker2apptainer.py from openfold3_ob0/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh openfold3_ob0          # or: mkdir -p _jitcache && apptainer build [--fakeroot] openfold3_ob0.sif openfold3_ob0/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# OpenFold3 0.5.0 (OpenBind-0) optimization kit — Apptainer / Singularity image made FROM the container image of openfold3_ob0/environment/Dockerfile:
# the same stack and the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged openfold3_ob0-kit:dev in the local
# Docker daemon (build it first: README.md 'Setup', route A); for a published tag the two header lines read `Bootstrap: docker` /
# `From: <registry>/openfold3_ob0-kit:<tag>`.
#   apptainer build openfold3_ob0.sif openfold3_ob0/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/weights:/weights --env OPENFOLD3_OB0_CKPT=/weights/of3-ob-2025-06-30-174k.pt --bind "$PWD/out":/out openfold3_ob0.sif \
#     pred --config h100 --mode fast --query-json /kit/openfold3_ob0/stock/src/examples/example_inference_inputs/query_ubiquitin.json --output-dir /out/fast --use-msa-server false
# The image is read-only: give every verb an output directory on a bound, writable path; the caches go under $HOME/.cache and $HOME/.triton (bound by
# default); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.8.1-devel-ubuntu22.04

%arguments
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    openfold3_ob0 /.ctx/openfold3_ob0

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential libxrender1 libxext6 libsm6 libgl1 \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz \
      "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -RL --preserve=mode,timestamps /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    export CUDA_HOME="/usr/local/cuda"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    _copy /.ctx/openfold3_ob0/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/openfold3_ob0/stock/PINS.json /.ctx/openfold3_ob0/stock/check_pins.py /.ctx/openfold3_ob0/stock/install_upstream.py /.ctx/openfold3_ob0/stock/*.whl /tmp/stock/
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
grep -v -E '^(#|openfold3==|deepspeed==)' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -I /tmp/stock/install_upstream.py --wheel-only \
 && J=${BUILD_JOBS:-0} && { [ "$J" -gt 0 ] || J=$(nproc --all); } && echo "deepspeed DS4Sci build: $J jobs on $(nproc --all) cores" \
 && MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J NVCC_THREADS=4 DS_NVCC_THREADS=4 \
    CC=gcc CXX=g++ LDSHARED='gcc -pthread -shared' LDCXXSHARED='g++ -pthread -shared' \
    DS_ACCELERATOR=cuda DS_BUILD_EVOFORMER_ATTN=1 TORCH_CUDA_ARCH_LIST="9.0" \
    python -m pip install --no-cache-dir --no-deps --no-build-isolation --no-binary deepspeed "$(grep -E '^deepspeed==' /tmp/requirements.lock)" \
 && python -c "from deepspeed.git_version_info import installed_ops; assert installed_ops.get('evoformer_attn'), installed_ops; print('DS4Sci evoformer_attn op: built')" \
 && python -m pip check \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/requirements.lock /root/.cache
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/openfold3_ob0 /kit/openfold3_ob0
    mkdir -p /kit/openfold3_ob0 && cd /kit/openfold3_ob0
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/openfold3_ob0/environment/Dockerfile /.ctx/_jitcache/openfold3_ob0-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export CUDA_HOME="/usr/local/cuda"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/openfold3_ob0 && exec bash /kit/openfold3_ob0/run.sh "$@"

%help
    OpenFold3 0.5.0 (OpenBind-0) optimization kit: drop-in modes that make stock OpenFold3 0.5.0 (`run_openfold predict`, OpenBind-0 weights)
    faster and lighter on GPU memory on an NVIDIA H100 without changing how it is called — off = stock exactly; exact = identical outputs, faster;
    fast = small documented numeric differences, faster still (the default); big = lowest memory for large inputs.
    `apptainer run --nv openfold3_ob0.sif <verb> ...` = `bash /kit/openfold3_ob0/run.sh <verb> ...` (verbs: install, pred, check, warm;
    /kit/openfold3_ob0/README.md inside the image). Requires an NVIDIA driver that runs CUDA 12.8 (570 or newer) and OPENFOLD3_OB0_CKPT naming the
    checkpoint that `install --weights DIR` fetched.

