# GENERATED by tools/docker2apptainer.py from boltz2/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh boltz2          # or: mkdir -p _jitcache && apptainer build [--fakeroot] boltz2.sif boltz2/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Boltz-2 optimization kit — Apptainer / Singularity image made FROM the container image of boltz2/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged boltz2-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/boltz2-kit:<tag>`.
#   apptainer build boltz2.sif boltz2/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/boltz_cache:/weights --env BOLTZ_CACHE=/weights --bind "$PWD/out":/out boltz2.sif \
#     pred --config h100 --mode fast --input /kit/boltz2/inputs/1BRS_barnase_barstar.yaml --out_dir /out/fast --seeds 0
# The image is read-only: give every verb an --out_dir / --out on a bound, writable path; the JIT caches go under $HOME (bound by default) unless
# MODEL_OPT_JIT_ROOT names another bound directory (caches shipped in the image under /opt/jit_cache are read-only here: run.sh seeds a writable copy
# under ${TMPDIR:-/tmp}/model_opt_jit-uid<uid> once; bind a persistent directory as MODEL_OPT_JIT_ROOT and run `warm` once per mode to keep compiled kernels across runs); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack,
# --cleanenv keeps the host's variables out.
Bootstrap: docker
From: python:3.11.12-slim-bookworm

%files
    _jitcache /.ctx/_jitcache
    boltz2 /.ctx/boltz2
    common /.ctx/common

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y build-essential gfortran && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/boltz2/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/boltz2/stock/boltz-2.2.1-py3-none-any.whl /tmp/stock/boltz-2.2.1-py3-none-any.whl
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
grep -E '^(pip|wheel)==' /tmp/requirements.lock > /tmp/pip.txt && python3.11 -m pip install --no-cache-dir --no-deps -r /tmp/pip.txt \
 && printf 'setuptools==82.0.1\n' > /tmp/build-constraints.txt \
 && grep -v -E '^(#|pip==|wheel==|boltz==)' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps --build-constraint /tmp/build-constraints.txt -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/boltz-2.2.1-py3-none-any.whl \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/pip.txt /tmp/build-constraints.txt /tmp/requirements.lock
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/boltz2 /kit/boltz2
    mkdir -p /kit/boltz2 && cd /kit/boltz2
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
bash run.sh install
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/boltz2/environment/Dockerfile /.ctx/_jitcache/boltz2-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/lib/python3.11/site-packages/nvidia/cu13/lib"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/lib/python3.11/site-packages/nvidia/cu13/lib"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/boltz2 && exec bash /kit/boltz2/run.sh "$@"

%help
    Boltz-2 optimization kit: drop-in modes that make stock Boltz-2 (boltz 2.2.1, `boltz predict`) faster or lighter on GPU memory with the same
    YAML inputs and the same per-prediction files — off = stock exactly; exact = identical outputs, faster; fast = small documented numeric
    differences, faster still (the default); big = lowest memory, with --n_gpu P to shard one prediction over P GPUs.
    `apptainer run --nv boltz2.sif <verb> ...` = `bash /kit/boltz2/run.sh <verb> ...` (verbs: install, pred, check, warm; /kit/boltz2/README.md
    inside the image). Requires an NVIDIA driver that runs CUDA 13.0 (580 or newer) and BOLTZ_CACHE naming the cache directory
    (`run.sh install --weights DIR` fills it once).

