# GENERATED by tools/docker2apptainer.py from protenix_v1/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh protenix_v1          # or: mkdir -p _jitcache && apptainer build [--fakeroot] protenix_v1.sif protenix_v1/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Protenix v1 optimization kit — Apptainer / Singularity image made FROM the container image of protenix_v1/environment/Dockerfile: the same
# stack and the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged protenix_v1-kit:dev in the local
# Docker daemon (build it first: README.md 'Setup'); for a published tag the two header lines read `Bootstrap: docker` /
# `From: <registry>/protenix_v1-kit:<tag>`.
#   apptainer build protenix_v1.sif protenix_v1/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/protenix_root:/weights --env PROTENIX_ROOT_DIR=/weights --bind "$PWD/out":/out protenix_v1.sif \
#     warm --config h100 --mode fast --out_dir /out/warm
# The image is read-only: give every verb an --out_dir on a bound, writable path and keep outputs outside the image (README.md
# 'Run'); the JIT caches go under /tmp (configs/h100.env: TORCH_EXTENSIONS_DIR, TRITON_CACHE_DIR — bind a persistent
# directory there to keep them across runs); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack,
# --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.9.1-devel-ubuntu22.04

%arguments
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    protenix_v1 /.ctx/protenix_v1

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LAYERNORM_TYPE="fast_layernorm"
    export CUDA_HOME="/usr/local/cuda"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y git wget build-essential clang ninja-build kalign && rm -rf /var/lib/apt/lists/* \
 && printf '#!/bin/sh\nexec /usr/bin/kalign "$@" </dev/null\n' > /usr/local/bin/kalign && chmod 755 /usr/local/bin/kalign
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
wget -q -O /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -a /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    _copy /.ctx/protenix_v1/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/protenix_v1/stock/protenix-1.1.0-py3-none-any.whl /tmp/stock/protenix-1.1.0-py3-none-any.whl
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
J=${BUILD_JOBS:-0}; [ "$J" -gt 0 ] || J=$(nproc --all); echo "build cores: $(nproc --all); build jobs: $J" \
 && export MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J NVCC_THREADS=4 \
 && grep -v -E '^(#|protenix==|torch==|triton==|nvidia-[a-z-]+-cu13==)' /tmp/requirements.lock > /tmp/pass1.txt \
 && grep -E '^(torch==|triton==|nvidia-[a-z-]+-cu13==)' /tmp/requirements.lock > /tmp/pass2.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/pass1.txt \
 && python3.11 -m pip install --no-cache-dir --no-deps -r /tmp/pass2.txt \
 && rm -f /usr/local/lib/python3.11/site-packages/nvidia/__init__.py \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/protenix-1.1.0-py3-none-any.whl \
 && python -c "import protenix.model.layer_norm.layer_norm as m; print('fast LayerNorm extension:', m.fast_layer_norm_cuda_v2.__file__)" \
 && rm -rf /tmp/stock /tmp/pass1.txt /tmp/pass2.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/protenix_v1 /kit/protenix_v1
    mkdir -p /kit/protenix_v1 && cd /kit/protenix_v1
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/protenix_v1/environment/Dockerfile /.ctx/_jitcache/protenix_v1-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LAYERNORM_TYPE="fast_layernorm"
    export CUDA_HOME="/usr/local/cuda"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/protenix_v1 && exec bash /kit/protenix_v1/run.sh "$@"

%help
    Protenix v1 optimization kit: drop-in modes that make stock Protenix (protenix 1.1.0, `protenix pred`) faster or lighter on GPU memory
    without changing how it is called — off = stock exactly; exact = stock's outputs (byte-identical under --det 1), faster; fast = small
    numeric differences inside stock's seed-to-seed spread, faster still (the default); big = lowest memory for large inputs, --n_gpu 2|4|8
    shards one prediction over the GPUs of one machine. `apptainer run --nv protenix_v1.sif <verb> ...` = `bash /kit/protenix_v1/run.sh <verb> ...`
    (verbs: install, probe, pred, check, warm; /kit/protenix_v1/README.md inside the image). Requires an NVIDIA driver that runs CUDA 13.0
    (580 or newer) and PROTENIX_ROOT_DIR naming the weights root.

