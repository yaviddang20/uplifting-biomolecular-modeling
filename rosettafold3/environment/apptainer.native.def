# GENERATED by tools/docker2apptainer.py from rosettafold3/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh rosettafold3          # or: mkdir -p _jitcache && apptainer build [--fakeroot] rosettafold3.sif rosettafold3/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# RoseTTAFold3 optimization kit — Apptainer / Singularity image made FROM the container image of rosettafold3/environment/Dockerfile: the same
# stack, the same two interpreters and the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged
# rosettafold3-kit:dev in the local Docker daemon (build it first: rosettafold3/environment/Dockerfile); for a published tag the two header lines read
# `Bootstrap: docker` / `From: <registry>/rosettafold3-kit:<tag>`.
#   apptainer build rosettafold3.sif rosettafold3/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/weights:/weights --env ROSETTAFOLD3_OPT_CKPT=/weights/rf3_foundry_01_24_latest_remapped.ckpt \
#     --bind "$PWD/out":/out rosettafold3.sif pred --config h100 --mode fast --input /kit/rosettafold3/opt/forward/rf3_xattempt_addon/public_inputs/1brs_tiles.json --out_dir /out/fast
# The image is read-only: give every verb an --out_dir on a bound, writable path; the JIT caches and the weights digest memo go under $HOME/.cache
# (bound by default); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out
# (the image's own PATH and ROSETTAFOLD3_OPT_STOCK_PYTHON stay). The container image already carries the add-on's five rf3 files in
# /kit/rosettafold3/opt/venv (applied when that image was built); %post runs the kit's install command from /kit/rosettafold3 once more, which
# checks them (and applies them on a source image built without them) and reads both interpreters' file states; /usr/local/bin/python stays
# pristine. A .sif belongs to one kit version: when the kit is updated, rebuild the container image and then this .sif.
Bootstrap: docker
From: nvidia/cuda:12.6.3-runtime-ubuntu22.04

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    rosettafold3 /.ctx/rosettafold3

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates wget git build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
wget -q -O /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20240107/cpython-3.12.1+20240107-x86_64_v3-unknown-linux-gnu-install_only.tar.gz" \
 && echo "a7bcc6c9f66dbd47ea99615f30f101c5d2dd0084ca333d2f7336e64050951338  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -a /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/rosettafold3/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
echo "build cores: $(nproc --all)" && grep -v -E '^#' /tmp/requirements.lock > /tmp/stack.txt \
 && printf 'hatchling==1.31.0\nhatch-vcs==0.4.0\n' > /tmp/build-pins.txt \
 && PIP_CONSTRAINT=/tmp/build-pins.txt python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps --force-reinstall nvidia-cudnn-cu13==9.20.0.48 nvidia-nccl-cu13==2.29.7 \
 && rm -f /tmp/stack.txt /tmp/build-pins.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/rosettafold3 /kit/rosettafold3
    mkdir -p /kit/rosettafold3 && cd /kit/rosettafold3
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install --make-venv
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/rosettafold3/environment/Dockerfile /.ctx/_jitcache/rosettafold3-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export ROSETTAFOLD3_OPT_STOCK_PYTHON="/usr/local/bin/python"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    cd /kit/rosettafold3 && opt/venv/bin/python -m rosettafold3_opt install --stock-python /usr/local/bin/python --opt-python /kit/rosettafold3/opt/venv/bin/python || exit 1
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export ROSETTAFOLD3_OPT_STOCK_PYTHON="/usr/local/bin/python"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/rosettafold3 && exec bash /kit/rosettafold3/run.sh "$@"

%help
    RoseTTAFold3 optimization kit: drop-in modes that make stock RoseTTAFold3 (`rf3 fold`, rc-foundry 0.2.1.dev13 at commit 4010e3e2e) faster and
    lighter on GPU memory without changing how it is called — off = stock exactly; exact = identical outputs, faster; fast = small documented
    numeric differences, faster still (the default); big = lowest memory, `--n_gpu 2|4|8` to shard one prediction. `apptainer run --nv
    rosettafold3.sif <verb> ...` = `bash /kit/rosettafold3/run.sh <verb> ...` (verbs: install, pred, check, warm; /kit/rosettafold3/README.md inside
    the image). Requires an NVIDIA driver that runs CUDA 13.0 (580 or newer) and ROSETTAFOLD3_OPT_CKPT naming the checkpoint file. The add-on's
    five patched rf3 files were put into /kit/rosettafold3/opt/venv when this image was built, from the kit tree at /kit/rosettafold3 of the same
    build (`bash run.sh check --config h100` reports the tree state); the image is read-only, so a kit update means rebuilding the container
    image and then this .sif.

