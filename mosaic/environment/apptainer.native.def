# GENERATED by tools/docker2apptainer.py from mosaic/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh mosaic          # or: mkdir -p _jitcache && apptainer build [--fakeroot] mosaic.sif mosaic/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# mosaic optimization kit — Apptainer / Singularity image made FROM the container image of mosaic/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged mosaic-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup', route A); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/mosaic-kit:<tag>`.
#   apptainer build mosaic.sif mosaic/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/mosaic_cache:/weights --env MOSAIC_CACHE_DIR=/weights --bind "$PWD/cache":/cache \
#     --env MOSAIC_OPT_CACHE_ROOT=/cache --bind "$PWD/out":/out mosaic.sif design --config h100 --mode fast --out /out/fast --seed 0
# The image is read-only: give every verb an --out (and MOSAIC_OPT_CACHE_ROOT, the P1 files' root that `warm` fills and `exact` reads) on a bound,
# writable path; %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.8.1-runtime-ubuntu22.04

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    mosaic /.ctx/mosaic

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20240107/cpython-3.12.1+20240107-x86_64_v3-unknown-linux-gnu-install_only.tar.gz" \
 && echo "a7bcc6c9f66dbd47ea99615f30f101c5d2dd0084ca333d2f7336e64050951338  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -a /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/mosaic/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
/usr/local/bin/python3 -m venv /kit/venv \
 && /kit/venv/bin/python -m pip install --no-cache-dir $(grep -E '^(pip|setuptools|wheel)==' /tmp/requirements.lock) \
 && /kit/venv/bin/python -m pip install --no-cache-dir --no-deps -r /tmp/requirements.lock \
 && /kit/venv/bin/python -m pip freeze > /kit/venv/pip_freeze_built.txt && rm -f /tmp/requirements.lock \
 && echo "the pinned stack is installed; nothing in this image is compiled ($(nproc --all) cores visible to the build)"
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    export PATH="/kit/venv/bin:$PATH"
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/mosaic /kit/mosaic
    mkdir -p /kit/mosaic && cd /kit/mosaic
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/mosaic/environment/Dockerfile /.ctx/_jitcache/mosaic-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PATH="/kit/venv/bin:$PATH"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/mosaic && exec bash /kit/mosaic/run.sh "$@"

%help
    mosaic optimization kit: drop-in modes that make stock escalante-bio mosaic (Boltz-2 binder hallucination through joltz, at its pinned
    commits) faster to start, faster per design step, or lighter on GPU memory without changing the recipe you run — off = stock exactly;
    exact = identical outputs, faster; fast = small documented numeric differences, faster still (the default); big = lowest memory.
    `apptainer run --nv --cleanenv mosaic.sif <verb> ...` = `bash /kit/mosaic/run.sh <verb> ...` (verbs: install, design, check, warm; /kit/mosaic/README.md
    inside the image). Requires an NVIDIA driver that runs CUDA 12 (550 or newer), MOSAIC_CACHE_DIR naming the weights cache and
    MOSAIC_OPT_CACHE_ROOT naming a writable directory for the P1 files.

