# GENERATED by tools/docker2apptainer.py from colabfold/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh colabfold          # or: mkdir -p _jitcache && apptainer build [--fakeroot] colabfold.sif colabfold/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# ColabFold optimization kit — Apptainer / Singularity image made FROM the container image of colabfold/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged colabfold-kit:dev in the local Docker daemon (build
# it first: `docker build -f colabfold/environment/Dockerfile -t colabfold-kit:dev .` from the directory holding colabfold/ and common/); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/colabfold-kit:<tag>`.
#   apptainer build colabfold.sif colabfold/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/af2_params:/weights --env COLABFOLD_OPT_DATA_DIR=/weights --bind "$PWD/out":/out colabfold.sif \
#     pred --config h100 --mode fast /kit/colabfold/tests/inputs/1BRS_AD.a3m /out/fast
# The image is read-only: give every verb a results directory on a bound, writable path; the compile cache and the weights digest memo go under
# $HOME/.cache (bound by default); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the
# host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%files
    _jitcache /.ctx/_jitcache
    colabfold /.ctx/colabfold
    common /.ctx/common

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl hhsuite kalign && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -RL --preserve=mode,timestamps /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/colabfold/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/colabfold/stock/*.whl /tmp/stock/
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
grep -v -E '^(#|colabfold==|alphafold-colabfold==)' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/*.whl \
 && python -m pip check && rm -rf /tmp/stock /tmp/stack.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/colabfold /kit/colabfold
    mkdir -p /kit/colabfold && cd /kit/colabfold
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/colabfold/environment/Dockerfile /.ctx/_jitcache/colabfold-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    export JAX_PLATFORMS="cuda"
    export JAX_COMPILATION_CACHE_DIR="/root/.cache/jax"
    export XLA_PYTHON_CLIENT_MEM_FRACTION="0.95"
    export TF_FORCE_UNIFIED_MEMORY="0"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export JAX_PLATFORMS="cuda"
    export JAX_COMPILATION_CACHE_DIR="/root/.cache/jax"
    export XLA_PYTHON_CLIENT_MEM_FRACTION="0.95"
    export TF_FORCE_UNIFIED_MEMORY="0"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/colabfold && exec bash /kit/colabfold/run.sh "$@"

%help
    ColabFold optimization kit: drop-in modes that make stock ColabFold 1.6.1 (colabfold_batch on the AlphaFold2-Multimer v3 weights,
    alphafold-colabfold 2.3.13) faster and lighter on GPU memory without changing how it is called — off = stock exactly; exact = identical
    outputs, faster; fast = small documented numeric differences, faster still (the default); big = fast's levers plus --n_gpu P sharding.
    `apptainer run --nv colabfold.sif <verb> ...` = `bash /kit/colabfold/run.sh <verb> ...` (verbs: install, pred, check, warm;
    /kit/colabfold/README.md inside the image). Requires an NVIDIA driver that runs CUDA 12 (550 or newer) and COLABFOLD_OPT_DATA_DIR naming the parameters root.

