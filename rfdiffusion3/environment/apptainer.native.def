# GENERATED by tools/docker2apptainer.py from rfdiffusion3/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh rfdiffusion3          # or: mkdir -p _jitcache && apptainer build [--fakeroot] rfdiffusion3.sif rfdiffusion3/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# RFdiffusion3 optimization kit — Apptainer / Singularity image made FROM the container image of rfdiffusion3/environment/Dockerfile: the same stack, the
# same two interpreters and the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged rfdiffusion3-kit:dev in the local Docker
# daemon (build it first with environment/Dockerfile: STOCK.md 'Stack'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/rfdiffusion3-kit:<tag>`.
#   apptainer build rfdiffusion3-kit.sif rfdiffusion3/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/weights:/weights --env RFD3_CKPT=/weights/rfd3_latest.ckpt --bind "$PWD":/work rfdiffusion3-kit.sif \
#     design --config h100 --mode fast inputs=/work/my_design.json out_dir=/work/out/fast n_batches=1 seed=101
# The image is read-only: give every design an out_dir= on a bound, writable path; the JIT caches go under $HOME/.cache (bound by default) or under
# MODEL_OPT_JIT_ROOT when that names a bound directory; %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack,
# --cleanenv keeps the host's variables out (the image's own PATH and RFDIFFUSION3_STOCK_PYTHON stay). The container image already carries the
# kit's ten-file overlay in /opt/kit (its Dockerfile applies it at build; /opt/stock stays pristine); %post re-runs `install apply` from
# /kit/rfdiffusion3 — a no-op on the applied files — and `check-only`, so a .sif is only assembled from an image whose /opt/kit matches the kit
# tree inside it. A .sif belongs to one kit version: when the kit is updated, rebuild the container image (route A) and then this .sif.
Bootstrap: docker
From: nvidia/cuda:12.8.1-runtime-ubuntu22.04

%arguments
    WHEELS_FROM=build
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    rfdiffusion3 /.ctx/rfdiffusion3

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export WHEELS_FROM="{{ WHEELS_FROM }}"
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20240107/cpython-3.12.1+20240107-x86_64_v3-unknown-linux-gnu-install_only.tar.gz" \
 && echo "a7bcc6c9f66dbd47ea99615f30f101c5d2dd0084ca333d2f7336e64050951338  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -RLp /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/rfdiffusion3/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/rfdiffusion3/stock /tmp/stock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
grep -v -E '^(#|apex==|rc-foundry==)' /tmp/requirements.lock > /tmp/stack.txt \
 && printf 'hatchling==1.32.0\nhatch-vcs==0.4.0\nsetuptools-scm==10.2.1\nvcs-versioning==2.3.1\n' > /tmp/build-pins.txt \
 && eval "$(python -c "import json; p = json.load(open('/tmp/stock/PINS.json')); a = p['pinned_stack']['apex']; print('FOUNDRY_VERSION=%s APEX_WHEEL=%s APEX_SHA256=%s APEX_REPO=%s APEX_COMMIT=%s' % (p['upstream']['foundry']['version'], a['wheel'], a['wheel_sha256'], a['repo'], a['commit']))")" \
 && for venv in /opt/stock /opt/kit; do \
      /usr/local/bin/python -m venv "$venv" \
   && "$venv/bin/python" -m pip install --no-cache-dir --no-deps "$(grep -E '^pip==' /tmp/stack.txt)" \
   && "$venv/bin/python" -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
   && SETUPTOOLS_SCM_PRETEND_VERSION="$FOUNDRY_VERSION" PIP_CONSTRAINT=/tmp/build-pins.txt "$venv/bin/python" -m pip install --no-cache-dir --no-deps /tmp/stock/foundry-4010e3e.tar.gz \
   || exit 1; \
    done \
 && if [ "$WHEELS_FROM" = build ]; then \
      J=${BUILD_JOBS:-0}; [ "$J" -gt 0 ] || J=$(nproc --all); P=$(( J < 8 ? J : 8 )); MJ=$(( J / P )); [ "$MJ" -gt 0 ] || MJ=1; \
      echo "apex $APEX_COMMIT from source: $(nproc --all) cores, BUILD_JOBS=$J ($P extensions at a time, $MJ ninja jobs each, nvcc --threads 4), TORCH_CUDA_ARCH_LIST=8.0;9.0+PTX" \
   && apt-get update && apt-get install -y --no-install-recommends cuda-nvcc-13-0 cuda-cudart-dev-13-0 cuda-nvrtc-dev-13-0 cuda-profiler-api-13-0 cuda-nvml-dev-13-0 \
        libcublas-dev-13-0 libcurand-dev-13-0 libcusparse-dev-13-0 libcusolver-dev-13-0 \
   && /usr/local/cuda-13.0/bin/nvcc --version | tail -1 \
   && curl -fsSL -o /tmp/apex.tar.gz "$APEX_REPO/archive/$APEX_COMMIT.tar.gz" && echo "f3cc6e36d357f5c47e39fe6f7ab7282ec7fc19af0b4a8425758ec2f2c6cc038e  /tmp/apex.tar.gz" | sha256sum -c - \
   && mkdir -p /tmp/src /tmp/stock/wheels && tar -xzf /tmp/apex.tar.gz -C /tmp/src \
   && /opt/stock/bin/python -m pip install --no-cache-dir --target /tmp/buildtools ninja==1.13.0 \
   && cd "/tmp/src/apex-$APEX_COMMIT" \
   && PYTHONPATH=/tmp/buildtools PATH=/tmp/buildtools/bin:/usr/local/cuda-13.0/bin:$PATH CUDA_HOME=/usr/local/cuda-13.0 CC=gcc CXX=g++ \
      APEX_CPP_EXT=1 APEX_CUDA_EXT=1 APEX_PARALLEL_BUILD=$P MAX_JOBS=$MJ CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J NVCC_APPEND_FLAGS="--threads 4" TORCH_CUDA_ARCH_LIST="8.0;9.0+PTX" \
      /opt/stock/bin/python -m pip wheel --no-deps --no-build-isolation --no-cache-dir -w /tmp/stock/wheels . \
   && cd / && echo "apex wheel compiled here (this build's own file, not the published one): $(sha256sum "/tmp/stock/wheels/$APEX_WHEEL")" \
   && apt-get purge -y --auto-remove cuda-nvcc-13-0 cuda-cudart-dev-13-0 cuda-nvrtc-dev-13-0 cuda-profiler-api-13-0 cuda-nvml-dev-13-0 \
        libcublas-dev-13-0 libcurand-dev-13-0 libcusparse-dev-13-0 libcusolver-dev-13-0 \
   && rm -rf /var/lib/apt/lists/* /tmp/src /tmp/buildtools /tmp/apex.tar.gz || exit 1; \
    elif [ "$WHEELS_FROM" = prebuilt ]; then echo "$APEX_SHA256  /tmp/stock/wheels/$APEX_WHEEL" | sha256sum -c - || exit 1; \
    elif [ "$WHEELS_FROM" = local ]; then [ -f "/tmp/stock/wheels/$APEX_WHEEL" ] || { echo "WHEELS_FROM=local: /tmp/stock/wheels/$APEX_WHEEL missing (tools/rfd3_apex/README.md)" >&2; exit 1; }; \
      echo "apex wheel compiled locally by tools/rfd3_apex (not the published file): $(sha256sum "/tmp/stock/wheels/$APEX_WHEEL")"; \
    else echo "WHEELS_FROM=$WHEELS_FROM: build, prebuilt or local" >&2; exit 2; fi \
 && for venv in /opt/stock /opt/kit; do \
      "$venv/bin/python" -m pip install --no-cache-dir --no-deps "/tmp/stock/wheels/$APEX_WHEEL" \
   && "$venv/bin/python" -c "import rfd3, apex, importlib; importlib.import_module('apex.normalization.fused_layer_norm'); import fused_layer_norm_cuda" \
   || exit 1; \
    done \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/build-pins.txt /tmp/requirements.lock /root/.cache
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/rfdiffusion3 /kit/rfdiffusion3
    mkdir -p /kit/rfdiffusion3 && cd /kit/rfdiffusion3
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
PATH=/opt/stock/bin:$PATH bash run.sh install \
 && PATH=/opt/kit/bin:$PATH bash run.sh install \
 && rm -rf /root/.cache
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
cd /kit/rfdiffusion3 && /opt/kit/bin/python -m rfdiffusion3_opt.install apply && /opt/kit/bin/python -m rfdiffusion3_opt.install check-only
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    _copy /.ctx/rfdiffusion3/environment/Dockerfile /.ctx/_jitcache/rfdiffusion3-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run6.sh <<'__DOCKER_RUN_6__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_6__
    /bin/sh /tmp/.run6.sh || { echo 'RUN step 6 failed' >&2; exit 1; }; rm -f /tmp/.run6.sh
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64"
    export PATH="/opt/kit/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export RFDIFFUSION3_STOCK_PYTHON="/opt/stock/bin/python"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    cd /kit/rfdiffusion3 && /opt/kit/bin/python -m rfdiffusion3_opt.install apply && /opt/kit/bin/python -m rfdiffusion3_opt.install check-only || exit 1
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64"
    export PATH="/opt/kit/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export RFDIFFUSION3_STOCK_PYTHON="/opt/stock/bin/python"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/rfdiffusion3 && exec bash /kit/rfdiffusion3/run.sh "$@"

%help
    RFdiffusion3 optimization kit: drop-in modes that make stock RFdiffusion3 (rfd3 design, RosettaCommons foundry at commit 4010e3e2) faster on one
    GPU without changing how it is called — off = stock exactly; exact = the same designs as eager stock, faster; fast = small documented numeric
    differences, faster still (the default). `apptainer run --nv rfdiffusion3-kit.sif <verb> ...` = `bash /kit/rfdiffusion3/run.sh <verb> ...` (verbs: install,
    design, check, warm; /kit/rfdiffusion3/README.md inside the image). Requires an NVIDIA driver that runs CUDA 13.0 (580 or newer) and RFD3_CKPT naming
    the checkpoint (`run.sh install --weights DIR` fetches it). The kit's ten patched rfd3 files were put into /opt/kit when this image was built, from
    the kit tree at /kit/rfdiffusion3 of the same build (`python -m rfdiffusion3_opt.install status` lists them); the image is read-only, so a kit
    update means rebuilding the container image and then this .sif.

