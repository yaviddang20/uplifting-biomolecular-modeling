# GENERATED by tools/docker2apptainer.py from enformer/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh enformer          # or: mkdir -p _jitcache && apptainer build [--fakeroot] enformer.sif enformer/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Enformer optimization kit — Apptainer / Singularity image made FROM the container image of enformer/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged enformer-kit:dev in the local Docker daemon (build
# it first with enformer/environment/Dockerfile); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/enformer-kit:<tag>`.
#   apptainer build enformer.sif enformer/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /data/hf_home:/weights --env HF_HOME=/weights --bind "$PWD/out":/out enformer.sif \
#     check
# The image is read-only; %environment keeps a host user site-packages (PEP 370) from
# shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: python:3.11.12-slim-bookworm

%files
    enformer /.ctx/enformer

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/enformer/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
grep -E '^(pip|wheel|uv)==' /tmp/requirements.lock > /tmp/tools.txt \
 && python3.11 -m pip install --no-cache-dir --no-deps -r /tmp/tools.txt
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/enformer/stock/enformer_pytorch-0.8.12-py3-none-any.whl /tmp/stock/enformer_pytorch-0.8.12-py3-none-any.whl
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
grep -v -E '^(#|(pip|wheel|uv|enformer-pytorch)==|nvidia-cudnn-frontend @ )' /tmp/requirements.lock > /tmp/stack.txt \
 && grep -E '^nvidia-cudnn-frontend @ ' /tmp/requirements.lock > /tmp/named.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/enformer_pytorch-0.8.12-py3-none-any.whl -r /tmp/named.txt \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/named.txt /tmp/tools.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/enformer /kit/enformer
    mkdir -p /kit/enformer && cd /kit/enformer
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/enformer && exec bash /kit/enformer/run.sh "$@"

%help
    Enformer optimization kit: a drop-in that makes stock enformer-pytorch 0.8.12 (official EleutherAI/enformer-official-rough weights)
    faster on one GPU without changing how it is called — off = stock exactly; exact = identical outputs, faster (the one optimized mode).
    `apptainer run --nv enformer.sif <verb> ...` = `bash /kit/enformer/run.sh <verb> ...` (verbs: install, check; /kit/enformer/README.md
    inside the image — your own code runs with ENFORMER_OPT=exact). Requires an NVIDIA driver that runs CUDA 13.0 (580 or newer) and HF_HOME
    naming the weights cache.

