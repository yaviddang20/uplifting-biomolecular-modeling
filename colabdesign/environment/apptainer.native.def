# GENERATED by tools/docker2apptainer.py from colabdesign/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh colabdesign          # or: mkdir -p _jitcache && apptainer build [--fakeroot] colabdesign.sif colabdesign/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# ColabDesign optimization kit — Apptainer / Singularity image made FROM the container image of colabdesign/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged colabdesign-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup'); no image is published — the source is always the locally built one.
#   apptainer build colabdesign.sif colabdesign/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/af2:/weights --env COLABDESIGN_PARAMS_DIR=/weights --bind "$PWD/out":/out colabdesign.sif \
#     design --config h100 --mode fast --starting-pdb /kit/colabdesign/stock/src/bindcraft/example/PDL1.pdb --chains A --binder-len 65 --target-hotspot-residues 56 --seed 0 --out /out/fast
# The image is read-only: give every verb an --out on a bound, writable path; jax's caches go under $HOME (bound by default). The runscript execs
# `run.sh "$@"`; the Docker entrypoint's `micromamba activate` is not involved: the image's PATH and LD_LIBRARY_PATH already put the environment
# first; %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: mambaorg/micromamba:2.1.1

%arguments
    MAMBA_DOCKERFILE_ACTIVATE=1
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    colabdesign /.ctx/colabdesign
    common /.ctx/common

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    # (ignored) USER root
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates git wget bzip2 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/colabdesign/environment/conda-linux-64.lock /tmp/conda-linux-64.lock
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
micromamba install -y -n base -f /tmp/conda-linux-64.lock \
 && micromamba clean -a -y && rm -f /tmp/conda-linux-64.lock
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    export MAMBA_DOCKERFILE_ACTIVATE="{{ MAMBA_DOCKERFILE_ACTIVATE }}"
    export PATH="/opt/conda/bin:/opt/conda/condabin:${PATH}"
    export LD_LIBRARY_PATH="/opt/conda/lib"
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export LANG="C.UTF-8"
    export LC_ALL="C.UTF-8"
    export MAMBA_DOCKERFILE_ACTIVATE="1"
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    _copy /.ctx/colabdesign/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
J=${BUILD_JOBS:-0}; [ "$J" -gt 0 ] || J=$(nproc --all); export MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J; echo "build cores: $(nproc --all), jobs: $J" \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/requirements.lock \
 && rm -f /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/colabdesign /kit/colabdesign
    mkdir -p /kit/colabdesign && cd /kit/colabdesign
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/colabdesign/environment/Dockerfile /.ctx/_jitcache/colabdesign-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PATH="/opt/conda/bin:/opt/conda/condabin:${PATH}"
    export LD_LIBRARY_PATH="/opt/conda/lib"
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export CFLAGS="-g0"
    export LANG="C.UTF-8"
    export LC_ALL="C.UTF-8"
    export MAMBA_DOCKERFILE_ACTIVATE="1"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/colabdesign && exec bash /kit/colabdesign/run.sh "$@"

%help
    ColabDesign optimization kit: drop-in modes that make BindCraft's binder-hallucination design step (BindCraft @ efb5bfeb on stock
    ColabDesign 1.1.3 @ e31a56fe with the AlphaFold-Multimer v3 weights) faster without changing how it is called — off = stock exactly;
    fast = small documented numeric differences, faster (the default).
    `apptainer run --nv colabdesign.sif <verb> ...` = `bash /kit/colabdesign/run.sh <verb> ...` (verbs: install, design, check, warm;
    /kit/colabdesign/README.md inside the image). Requires an NVIDIA driver that loads the environment's CUDA 12.9 libraries (tested with driver 575; CUDA 12 minor-version compatibility from R525 on, untested here) and COLABDESIGN_PARAMS_DIR naming the weights root.

