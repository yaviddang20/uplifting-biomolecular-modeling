# GENERATED by tools/docker2apptainer.py from proteinmpnn/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh proteinmpnn          # or: mkdir -p _jitcache && apptainer build [--fakeroot] proteinmpnn.sif proteinmpnn/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# ProteinMPNN optimization kit — Apptainer / Singularity image made FROM the container image of proteinmpnn/environment/Dockerfile:
# the same stack and the same /kit, no ProteinMPNN checkout and no weights, for hosts that run Apptainer instead of Docker. The source is the image
# tagged proteinmpnn-kit:dev in the local Docker daemon (build it first: README.md 'Setup'); for a published tag the two header lines
# read `Bootstrap: docker` / `From: <registry>/proteinmpnn-kit:<tag>`.
#   apptainer build proteinmpnn.sif proteinmpnn/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind "$PWD/ProteinMPNN":/opt/ProteinMPNN proteinmpnn.sif install --weights /opt/ProteinMPNN   # once: the clone
#   apptainer run --nv --cleanenv --bind "$PWD/ProteinMPNN":/opt/ProteinMPNN --bind "$PWD/out":/out proteinmpnn.sif \
#     design --config h100 --mode exact --input /opt/ProteinMPNN/inputs/PDB_monomers/pdbs --out /out/exact --seed 37
# The image is read-only and holds no weights: bind a writable host directory at /opt/ProteinMPNN (the image's MPNN_DIR; `install --weights`
# fills it with the ProteinMPNN clone, code and weights) and give every pass an --out on a bound, writable path; %environment keeps a host user
# site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.4.1-runtime-ubuntu22.04

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    proteinmpnn /.ctx/proteinmpnn

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export PYTHONHASHSEED="0"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -RL /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/proteinmpnn/environment /tmp/environment
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
python -m pip install --no-cache-dir --no-deps -r /tmp/environment/requirements-mpnn.lock && rm -rf /tmp/environment
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/proteinmpnn /kit/proteinmpnn
    mkdir -p /kit/proteinmpnn && cd /kit/proteinmpnn
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
python -m pip install --no-cache-dir -e /kit/common/opt_core -e /kit/proteinmpnn/opt && python -c "from proteinmpnn_opt import core_gate; core_gate()"
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/proteinmpnn/environment/Dockerfile /.ctx/_jitcache/proteinmpnn-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    export MPNN_DIR="/opt/ProteinMPNN"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export MPNN_DIR="/opt/ProteinMPNN"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/proteinmpnn && exec bash /kit/proteinmpnn/run.sh "$@"

%help
    ProteinMPNN optimization kit: drop-in modes that make stock ProteinMPNN (dauparas/ProteinMPNN; weight sets --variant soluble | vanilla)
    design faster without changing the inputs or the files — off = stock exactly; exact = identical outputs at the same --seed, faster. `apptainer run --nv proteinmpnn.sif <verb> ...` = `bash /kit/proteinmpnn/run.sh
    <verb> ...` (verbs: install, design, check, warm; /kit/proteinmpnn/README.md inside the image). No weights inside: bind a writable directory at
    /opt/ProteinMPNN and run `install --weights /opt/ProteinMPNN` once. Requires an NVIDIA driver that runs CUDA 12.4 (550 or newer).

