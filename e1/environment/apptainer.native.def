# GENERATED by tools/docker2apptainer.py from e1/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh e1          # or: mkdir -p _jitcache && apptainer build [--fakeroot] e1.sif e1/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# E1 optimization kit — Apptainer / Singularity image made FROM the container image of e1/environment/Dockerfile: the same stack and the same
# /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged e1-kit:dev in the local Docker daemon (build it first:
# README.md 'Setup'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/e1-kit:<tag>`.
#   apptainer build e1.sif e1/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/hf_home:/weights --env HF_HOME=/weights --bind "$PWD/out":/out e1.sif \
#     score --config h100 --variant 600m --mode exact --parent-path /kit/e1/opt/e1_opt/tests/fixtures/warm/parent.fasta \
#       --mutants-path /kit/e1/opt/e1_opt/tests/fixtures/warm/mutants.fasta --output-path /out/exact/scores.csv
# The image is read-only: give `score` an --output-path on a bound, writable path; the JIT caches go under $HOME/.cache (bound by default) or
# MODEL_OPT_JIT_ROOT; %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: python:3.12.10-slim-bookworm

%files
    _jitcache /.ctx/_jitcache
    e1 /.ctx/e1

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
echo "build host: $(nproc --all) cores" && apt-get update && apt-get install -y --no-install-recommends build-essential git ca-certificates && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    export PYTHONUNBUFFERED="1"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export USE_FLASH_ATTN="1"
    export HF_HUB_DISABLE_TELEMETRY="1"
    export DISABLE_TELEMETRY="1"
    export KERNELS_CACHE="/opt/kernels_cache"
    _copy /.ctx/e1/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
python3.12 -m pip install --no-cache-dir "$(grep -E '^pip==' /tmp/requirements.lock)" \
 && echo 'hatchling==1.32.0' > /tmp/build-constraints.txt \
 && PIP_CONSTRAINT=/tmp/build-constraints.txt python3.12 -m pip install --no-cache-dir --no-deps -r /tmp/requirements.lock \
 && rm -f /tmp/requirements.lock /tmp/build-constraints.txt
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/e1 /kit/e1
    mkdir -p /kit/e1 && cd /kit/e1
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
bash run.sh install \
 && python -m e1_opt.weights --kernels-cache "$KERNELS_CACHE"
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/e1/environment/Dockerfile /.ctx/_jitcache/e1-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONUNBUFFERED="1"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export USE_FLASH_ATTN="1"
    export HF_HUB_DISABLE_TELEMETRY="1"
    export DISABLE_TELEMETRY="1"
    export KERNELS_CACHE="/opt/kernels_cache"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/e1 && exec bash /kit/e1/run.sh "$@"

%help
    E1 optimization kit: drop-in modes that make stock E1 1.0.0 (the `python -m E1.tools.score` point-mutant scorer, sizes 150m / 300m / 600m)
    faster without changing how it is called — off = stock exactly; exact = the same scores.csv, faster (the default).
    `apptainer run --nv e1.sif <verb> ...` = `bash /kit/e1/run.sh <verb> ...` (verbs: install, score, check, warm;
    /kit/e1/README.md inside the image). Requires an NVIDIA driver that runs CUDA 12.8 (570 or newer) and HF_HOME naming the staged weights.

