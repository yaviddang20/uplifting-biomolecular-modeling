# GENERATED by tools/docker2apptainer.py from opendde/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh opendde          # or: mkdir -p _jitcache && apptainer build [--fakeroot] opendde.sif opendde/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# OpenDDE optimization kit — Apptainer / Singularity image made FROM the container image of opendde/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged opendde-kit:dev in the local Docker daemon (build
# it first: README.md 'Setup'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/opendde-kit:<tag>`.
#   apptainer build opendde.sif opendde/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/opendde_root:/weights --env OPENDDE_ROOT_DIR=/weights --bind "$PWD/out":/out opendde.sif \
#     warm --config h100 -o /out/warm
# The image is read-only: give every verb an output directory (-o) on a bound, writable path; the JIT caches (Triton, the fused-LayerNorm
# extension build) go under $HOME/.cache (bound by default) or under MODEL_OPT_JIT_ROOT when set; %environment keeps a host user site-packages
# (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.6.3-devel-ubuntu24.04

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    opendde /.ctx/opendde

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl git hmmer kalign=1:3.3.5-1 libglib2.0-0 libgl1 libxrender1 pkg-config tzdata \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -aL /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/opendde/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/opendde/stock/opendde-1.1.1-py3-none-any.whl /tmp/stock/opendde-1.1.1-py3-none-any.whl
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
echo "installing the pinned stack (build host: $(nproc --all) cores; nothing is compiled)" \
 && grep -v -E '^(#|opendde==)' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/opendde-1.1.1-py3-none-any.whl \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/opendde /kit/opendde
    mkdir -p /kit/opendde && cd /kit/opendde
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/opendde/environment/Dockerfile /.ctx/_jitcache/opendde-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export PYTHONDONTWRITEBYTECODE="1"
    export CFLAGS="-g0"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export PYTHONUNBUFFERED="1"
    export PYTHONDONTWRITEBYTECODE="1"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/opendde && exec bash /kit/opendde/run.sh "$@"

%help
    OpenDDE optimization kit: drop-in modes that make stock OpenDDE 1.1.1 (`opendde pred`, model opendde_v1) faster or lighter on GPU memory
    without changing how it is called — off = stock exactly; exact = stock's outputs bit for bit (under --det 1), faster; fast = small
    documented numeric differences, faster still (the default); big = lowest GPU memory for large inputs. `apptainer run --nv opendde.sif
    <verb> ...` = `bash /kit/opendde/run.sh <verb> ...` (verbs: install, pred, check, warm; /kit/opendde/README.md inside the image). Requires an
    NVIDIA driver that runs CUDA 12.6 (560 or newer) and OPENDDE_ROOT_DIR naming the weights root.

