# GENERATED by tools/docker2apptainer.py from esm_if1/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh esm_if1          # or: mkdir -p _jitcache && apptainer build [--fakeroot] esm_if1.sif esm_if1/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# ESM-IF1 optimization kit — Apptainer / Singularity image made FROM the container image of esm_if1/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged esm_if1-kit:dev in the local Docker daemon (build it
# first: esm_if1/environment/Dockerfile); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/esm_if1-kit:<tag>`.
#   apptainer build esm_if1.sif esm_if1/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/weights:/weights --env ESM_IF1_WEIGHTS=/weights/esm_if1_gvp4_t16_142M_UR50.pt --bind "$PWD/out":/out esm_if1.sif \
#     design --config h100 --chain A --num-samples 8 --input /out/backbones --out /out/run
# The image is read-only: give `design` an --out on a bound, writable path and keep MODEL_OPT_STATE / TORCH_HOME (default $HOME/.cache/esm_if1_opt,
# bound by default) writable; %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.1.1-runtime-ubuntu22.04

%files
    common /.ctx/common
    esm_if1 /.ctx/esm_if1

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential && rm -rf /var/lib/apt/lists/* \
 && echo "build cores: $(nproc --all)"
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -a /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/esm_if1/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/esm_if1/stock/fair-esm-2b369911.tar.gz /tmp/stock/fair-esm-2b369911.tar.gz
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
grep -v -E '^(#|fair-esm @)' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/fair-esm-2b369911.tar.gz \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/esm_if1 /kit/esm_if1
    mkdir -p /kit/esm_if1 && cd /kit/esm_if1
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/esm_if1 && exec bash /kit/esm_if1/run.sh "$@"

%help
    ESM-IF1 optimization kit: one command line around ESM-IF1 sequence design (facebookresearch/esm @ 2b369911, checkpoint
    esm_if1_gvp4_t16_142M_UR50) — backbones in, S sampled sequences per backbone out; `--mode off` is stock (upstream's sample_sequences.py as
    shipped); `--mode fast`, the default, is batched sampling over upstream's unmodified encoder and decoder (any other mode word exits 2 with one usage line).
    `apptainer run --nv esm_if1.sif <verb> ...` = `bash /kit/esm_if1/run.sh <verb> ...` (verbs: install, design, check; /kit/esm_if1/README.md inside
    the image). Requires an NVIDIA driver that runs CUDA 12.1 (530 or newer); ESM_IF1_WEIGHTS names the checkpoint (or TORCH_HOME holds it).

