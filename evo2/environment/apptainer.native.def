# GENERATED by tools/docker2apptainer.py from evo2/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh evo2          # or: mkdir -p _jitcache && apptainer build [--fakeroot] evo2.sif evo2/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Evo 2 optimization kit — Apptainer / Singularity image made FROM the container image of evo2/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged evo2-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup' — with `--build-arg STACK=img_a100` for the A100 stack); for a published tag the two header lines read
# `Bootstrap: docker` / `From: <registry>/evo2-kit:<tag>`.
#   apptainer build evo2.sif evo2/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/evo2_weights:/weights --env EVO2_OPT_WEIGHTS=/weights --bind "$PWD/out":/out evo2.sif \
#     score --model_name evo2_7b --input /out/windows.fa --out_dir /out/exact
# The image is read-only: give every verb an --out_dir on a bound, writable path and keep the input FASTA there too; Triton's kernel cache goes
# under $HOME/.triton (bound by default) unless TRITON_CACHE_DIR names another bound path; %environment keeps a host user site-packages (PEP 370)
# from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.8.1-devel-ubuntu22.04

%arguments
    STACK=img_full
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    evo2 /.ctx/evo2

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export STACK="{{ STACK }}"
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.11.5+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "fbed6f7694b2faae5d7c401a856219c945397f772eea5ca50c6eb825cbc9d1e1  /tmp/python.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/python.tar.gz -C /tmp && cp -aL /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/evo2/environment/ /tmp/environment/
    _copy /.ctx/evo2/stock/vtx-1.1.0-py3-none-any.whl /.ctx/evo2/stock/evo2-0.6.0-py3-none-any.whl /tmp/stock/
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
test -f /tmp/environment/requirements-${STACK}.lock || { echo "no such stack: ${STACK} (evo2/environment/requirements-<stack>.lock: img_full | img_a100)" >&2; exit 2; } \
 && grep -v -E '^(#|evo2==|vtx==|transformer-engine-torch==)' /tmp/environment/requirements-${STACK}.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && { grep -E '^transformer-engine-torch==' /tmp/environment/requirements-${STACK}.lock > /tmp/te.txt || true; } \
 && if [ -s /tmp/te.txt ]; then J=${BUILD_JOBS:-0}; [ "$J" -gt 0 ] || J=$(nproc --all); echo "transformer-engine-torch: compiling with $J parallel jobs ($(nproc --all) cores on this machine)"; \
         export MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J NVTE_BUILD_THREADS_PER_JOB=2; \
         CUDNN_PATH="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/nvidia/cudnn" CC=gcc CXX=g++ NVTE_CUDA_ARCHS=90 \
         python -m pip install --no-cache-dir --no-deps --no-build-isolation -r /tmp/te.txt || exit 1; fi \
 && python -m pip install --no-cache-dir --no-deps /tmp/stock/vtx-1.1.0-py3-none-any.whl /tmp/stock/evo2-0.6.0-py3-none-any.whl \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/te.txt /tmp/environment
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/evo2 /kit/evo2
    mkdir -p /kit/evo2 && cd /kit/evo2
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/evo2/environment/Dockerfile /.ctx/_jitcache/evo2-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib:/usr/local/cuda/lib64"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LD_LIBRARY_PATH="/usr/local/lib/python3.11/site-packages/nvidia/cudnn/lib:/usr/local/cuda/lib64"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    exec bash /kit/evo2/run.sh "$@"

%help
    Evo 2 optimization kit: drop-in modes that make stock Evo 2 (evo2 0.6.0 on vtx 1.1.0; variants 7b and 40b) faster at per-base scoring and
    prompted generation without changing how it is called and without changing the outputs — one mode, exact (identical outputs, faster; the
    default); off = the stock. `apptainer run --nv evo2.sif <verb> ...` = `bash /kit/evo2/run.sh <verb> ...` (verbs: install, check, score;
    /kit/evo2/README.md inside the image). Requires an NVIDIA driver that runs CUDA 12.8 (570 or newer) and EVO2_OPT_WEIGHTS naming the weights
    directory; H100 80GB for the default stack (evo2_7b on one visible device, evo2_40b on two), A100 80GB for an image built with STACK=img_a100 (evo2_7b).

