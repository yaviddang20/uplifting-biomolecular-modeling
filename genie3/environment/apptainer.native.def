# GENERATED by tools/docker2apptainer.py from genie3/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh genie3          # or: mkdir -p _jitcache && apptainer build [--fakeroot] genie3.sif genie3/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Genie 3 optimization kit — Apptainer / Singularity image made FROM the container image of genie3/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged genie3-kit:dev in the local Docker daemon (build it
# first: README.md Setup); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/genie3-kit:<tag>`,
# and on a host without a Docker daemon `Bootstrap: docker-archive` / `From: genie3.tar` (after `docker save genie3-kit:dev -o genie3.tar` elsewhere).
#   apptainer build genie3.sif genie3/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/genie3_downloads:/weights --env GENIE3_WEIGHTS=/weights/pretrained/v1 --bind "$PWD/out":/out genie3.sif \
#     design --config h100 --mode fast --input /opt/genie3/examples/binder_design/experiment.yaml --out_dir /out/fast --seed 0
# The image is read-only: give every verb an --out_dir on a bound, writable path; the weights-digest memo and the Triton kernel cache go under
# $HOME/.cache and $HOME/.triton (bound by default); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack,
# --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

%files
    _jitcache /.ctx/_jitcache
    common /.ctx/common
    genie3 /.ctx/genie3

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/python.tar.gz "https://github.com/indygreg/python-build-standalone/releases/download/20230826/cpython-3.10.13+20230826-x86_64-unknown-linux-gnu-install_only.tar.gz" \
 && echo "ba512bcca3ac6cb6d834f496cd0a66416f0a53ff20b05c4794fa82ece185b85a  /tmp/python.tar.gz" | sha256sum -c - \
 && mkdir /tmp/py && tar -xzf /tmp/python.tar.gz -C /tmp/py && cp -RL /tmp/py/python/. /usr/local/ && rm -rf /tmp/py /tmp/python.tar.gz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python && python3 -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
/usr/local/bin/python3 -m venv /opt/venv_g3
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    export PATH="/opt/venv_g3/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    _copy /.ctx/genie3/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
python -m pip install --no-cache-dir "$(grep '^pip==' /tmp/requirements.lock)" \
 && grep -v -E '^(#|-e )' /tmp/requirements.lock > /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && python -m pip install --no-cache-dir --no-deps --no-build-isolation --src /opt $(grep '^-e ' /tmp/requirements.lock) \
 && python -m pip check \
 && git -C /opt/genie3 log -1 --format='genie3 checkout %H' && rm -rf /opt/genie3/.git \
 && rm -f /tmp/stack.txt /tmp/requirements.lock
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/genie3 /kit/genie3
    mkdir -p /kit/genie3 && cd /kit/genie3
    export GENIE3_ROOT="/opt/genie3"
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
bash run.sh install
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    _copy /.ctx/genie3/environment/Dockerfile /.ctx/_jitcache/genie3-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run6.sh <<'__DOCKER_RUN_6__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_6__
    /bin/sh /tmp/.run6.sh || { echo 'RUN step 6 failed' >&2; exit 1; }; rm -f /tmp/.run6.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PATH="/opt/venv_g3/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export GENIE3_ROOT="/opt/genie3"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/genie3 && exec bash /kit/genie3/run.sh "$@"

%help
    Genie 3 optimization kit: drop-in modes that make stock Genie 3 (aqlaboratory/genie3 @ d77ae5ac) produce backbone designs faster
    without changing the request file you give it — off = stock exactly; exact = the same PDB files as stock, faster; fast = small documented
    numeric differences, faster still (the default). `apptainer run --nv genie3.sif <verb> ...` = `bash /kit/genie3/run.sh <verb> ...` (verbs: install, design, check, warm;
    /kit/genie3/README.md inside the image). Requires an NVIDIA driver that runs CUDA 12 applications (525.60 or newer) and GENIE3_WEIGHTS naming
    the directory that holds checkpoints/step=600000.ckpt and config.yaml (`run.sh install --weights DIR` fetches them: DIR/pretrained/v1).

