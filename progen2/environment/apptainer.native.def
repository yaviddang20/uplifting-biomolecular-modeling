# GENERATED by tools/docker2apptainer.py from progen2/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh progen2          # or: mkdir -p _jitcache && apptainer build [--fakeroot] progen2.sif progen2/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# ProGen2 optimization kit — Apptainer / Singularity image made FROM the container image of progen2/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged progen2-kit:dev in the local Docker daemon (build it
# first: STOCK.md 'Pinned stack'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/progen2-kit:<tag>`.
#   apptainer build progen2.sif progen2/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/progen2_weights:/weights --env PROGEN2_WEIGHTS=/weights --bind "$PWD/out":/out progen2.sif \
#     score --model progen2-xlarge --mode exact --input /out/items.jsonl --out_dir /out/score
# The image is read-only: give every verb an --out_dir on a bound, writable path and leave PROGEN2_RUN_DIR unset (the stock run directory then goes
# under the bound, writable /tmp); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.8.1-runtime-ubuntu22.04

%files
    progen2 /.ctx/progen2

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
echo "build host: $(nproc --all) cores" && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl build-essential && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
curl -fsSL -o /tmp/uv.tar.gz "https://github.com/astral-sh/uv/releases/download/0.8.13/uv-x86_64-unknown-linux-gnu.tar.gz" \
 && echo "8ca3db7b2a3199171cfc0870be1f819cb853ddcec29a5fa28dae30278922b7ba  /tmp/uv.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/uv.tar.gz -C /tmp && install -m 0755 /tmp/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv \
 && UV_PYTHON_INSTALL_DIR=/opt/python UV_PYTHON_BIN_DIR=/tmp/uv-bin UV_CACHE_DIR=/tmp/uv-cache uv python install cpython-3.9.23-linux-x86_64-gnu \
 && UV_CACHE_DIR=/tmp/uv-cache uv venv /opt/venv --python /opt/python/cpython-3.9.23-linux-x86_64-gnu/bin/python3.9 \
 && rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu /tmp/uv-bin /tmp/uv-cache /usr/local/bin/uv && /opt/venv/bin/python -V
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    export PATH="/opt/venv/bin:${PATH}"
    _copy /.ctx/progen2/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
python -m ensurepip --default-pip >/dev/null && grep -E '^pip==' /tmp/requirements.lock | xargs python -m pip install --no-cache-dir \
 && python -m pip install --no-cache-dir --no-deps -r /tmp/requirements.lock \
 && rm -f /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/progen2 /kit/progen2
    mkdir -p /kit/progen2 && cd /kit/progen2
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    export PYTHONHASHSEED="0"
    export PYTHONDONTWRITEBYTECODE="1"
    export CFLAGS="-g0"
    export TOKENIZERS_PARALLELISM="false"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PATH="/opt/venv/bin:${PATH}"
    export PYTHONHASHSEED="0"
    export PYTHONDONTWRITEBYTECODE="1"
    export CFLAGS="-g0"
    export TOKENIZERS_PARALLELISM="false"
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/progen2 && exec bash /kit/progen2/run.sh "$@"

%help
    ProGen2 optimization kit: the two documented ProGen2 commands, generation (sample.py) and likelihood scoring (likelihood.py), on the seven released
    model sizes — mode off = stock exactly, one clean process per item; mode exact = identical outputs, faster (both routes in the calling process,
    the model loaded once; the default). `apptainer run --nv progen2.sif <verb> ...` = `bash /kit/progen2/run.sh <verb> ...` (verbs: install,
    sample, score, check; /kit/progen2/README.md inside the image). Requires an NVIDIA driver that runs CUDA 12.8 (570 or newer), a GPU of
    compute capability 8.0 / 9.0 / 10.0 (A100, H100 / H200, B200) and PROGEN2_WEIGHTS naming the weights root (<dir>/<progen2-size>/{pytorch_model.bin, config.json}).

