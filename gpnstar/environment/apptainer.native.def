# GENERATED by tools/docker2apptainer.py from gpnstar/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh gpnstar          # or: mkdir -p _jitcache && apptainer build [--fakeroot] gpnstar.sif gpnstar/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# GPN-Star optimization kit — Apptainer / Singularity image made FROM the container image of gpnstar/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged gpnstar-kit:dev in the local Docker daemon (build
# it first: README.md 'Setup'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/gpnstar-kit:<tag>`.
#   apptainer build gpnstar-kit.sif gpnstar/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/hf_home:/weights --env HF_HOME=/weights gpnstar-kit.sif check
#   apptainer exec --nv --cleanenv --bind /path/to/hf_home:/weights --env HF_HOME=/weights --env HF_HUB_OFFLINE=1 --env GPNSTAR_OPT=exact --bind "$PWD/out":/out gpnstar-kit.sif \
#     gpn star vep … --output-path /out/scores.parquet --tf32
# The image is read-only: give upstream's commands output paths on a bound, writable path; %environment keeps a host user site-packages (PEP 370)
# from shadowing the pinned stack, --cleanenv keeps the host's variables out (pass GPNSTAR_OPT / HF_HOME with --env).
Bootstrap: docker
From: python:3.13.15-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e

%files
    common /.ctx/common
    gpnstar /.ctx/gpnstar

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export PYTHONUNBUFFERED="1"
    export PYTHONHASHSEED="0"
    export HF_HUB_DISABLE_TELEMETRY="1"
    export DISABLE_TELEMETRY="1"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update \
 && apt-get install -y --no-install-recommends gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/gpnstar/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/gpnstar/stock/gpn-6f28c81b.tar.gz /tmp/stock/gpn-6f28c81b.tar.gz
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
echo "build host: $(nproc --all) cores" \
 && python3.13 -m pip install --no-cache-dir "$(grep -E '^pip==' /tmp/requirements.lock)" \
 && grep -v -E '^(#|pip==|[.]/gpnstar/stock/)' /tmp/requirements.lock > /tmp/stack.txt \
 && python3.13 -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && echo 'hatchling==1.32.0' > /tmp/build-constraints.txt \
 && PIP_CONSTRAINT=/tmp/build-constraints.txt python3.13 -m pip install --no-cache-dir --no-deps /tmp/stock/gpn-6f28c81b.tar.gz \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/requirements.lock /tmp/build-constraints.txt
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/gpnstar /kit/gpnstar
    mkdir -p /kit/gpnstar && cd /kit/gpnstar
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
bash run.sh install
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONUNBUFFERED="1"
    export PYTHONHASHSEED="0"
    export HF_HUB_DISABLE_TELEMETRY="1"
    export DISABLE_TELEMETRY="1"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/gpnstar && exec bash /kit/gpnstar/run.sh "$@"

%help
    GPN-Star optimization kit: one drop-in mode, exact, that makes stock GPN-Star inference (gpn 0.9.0: the `gpn star vep | logits | embedding`
    commands over the released checkpoints) faster without changing how it is called — the same outputs, bit for bit, under the caller's own
    numerics flags (`--tf32` included). `apptainer run --nv gpnstar-kit.sif <verb>` = `bash /kit/gpnstar/run.sh <verb>` (verbs: install, check);
    the kit itself is `apptainer exec --nv --env GPNSTAR_OPT=exact gpnstar-kit.sif gpn star …` (/kit/gpnstar/README.md inside the image).
    Requires an NVIDIA driver that runs CUDA 13.0 (580 or newer) and HF_HOME naming the staged weights.

