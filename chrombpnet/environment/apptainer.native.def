# GENERATED by tools/docker2apptainer.py from chrombpnet/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh chrombpnet          # or: mkdir -p _jitcache && apptainer build [--fakeroot] chrombpnet.sif chrombpnet/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# ChromBPNet optimization kit — Apptainer / Singularity image made FROM the container image of chrombpnet/environment/Dockerfile: the same stack and
# the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged chrombpnet-kit:dev in the local Docker daemon (build
# it first: README.md 'Setup'); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/chrombpnet-kit:<tag>`.
#   apptainer build chrombpnet.sif chrombpnet/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/weights:/weights --bind /path/to/data:/data --env CHROMBPNET_OPT_WEIGHTS=/weights \
#     --env CHROMBPNET_OPT_DATA=/data --bind "$PWD/out":/out chrombpnet.sif warm --config h100 --out /out/warm
# The image is read-only: give every verb an output prefix / --out on a bound, writable path; the Triton and CUDA driver caches go under $HOME
# (bound by default); %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: tensorflow/tensorflow:2.8.2-gpu

%files
    _jitcache /.ctx/_jitcache
    chrombpnet /.ctx/chrombpnet

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
rm -f /etc/apt/sources.list.d/cuda.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y wget bzip2 ca-certificates curl git jq libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf2.0-0 libffi-dev \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/chrombpnet/environment/requirements.lock /tmp/requirements.lock
    _copy /.ctx/chrombpnet/stock/chrombpnet-eaa0fe58.tar.gz /tmp/chrombpnet-eaa0fe58.tar.gz
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
grep -E '^(pip|setuptools)==' /tmp/requirements.lock | xargs python3 -m pip install --no-cache-dir \
 && grep -v -E '^(#|$)' /tmp/requirements.lock > /tmp/stack.txt \
 && python3 -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && mkdir -p /scratch && tar -xzf /tmp/chrombpnet-eaa0fe58.tar.gz -C /scratch && mv /scratch/chrombpnet-eaa0fe58 /scratch/chrombpnet \
 && python3 -m pip install --no-cache-dir --no-deps /scratch/chrombpnet \
 && rm -f /tmp/stack.txt /tmp/requirements.lock /tmp/chrombpnet-eaa0fe58.tar.gz
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/chrombpnet/environment/requirements-opt-torch.lock /tmp/requirements-opt-torch.lock
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
python -m pip install --no-cache-dir --no-deps --target /opt/torch -r /tmp/requirements-opt-torch.lock && rm -f /tmp/requirements-opt-torch.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/chrombpnet /kit/chrombpnet
    mkdir -p /kit/chrombpnet && cd /kit/chrombpnet
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    _copy /.ctx/chrombpnet/environment/Dockerfile /.ctx/_jitcache/chrombpnet-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/chrombpnet && exec bash /kit/chrombpnet/run.sh "$@"

%help
    ChromBPNet optimization kit: `fast` runs stock chrombpnet 1.0.1's `pred_bw` job through the kit's entry script (a Triton forward on H100 /
    H200, the stock TensorFlow path elsewhere) with the same seven outputs; `off` is the stock CLI exactly. `apptainer run --nv chrombpnet.sif
    <verb> ...` = `bash /kit/chrombpnet/run.sh <verb> ...` (verbs: install, pred_bw, check, warm; /kit/chrombpnet/README.md inside the image).
    Requires an NVIDIA driver that runs CUDA 12.4 (550 or newer) and CHROMBPNET_OPT_WEIGHTS / CHROMBPNET_OPT_DATA naming the weights and data roots.

