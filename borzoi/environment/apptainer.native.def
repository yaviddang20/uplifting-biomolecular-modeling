# GENERATED by tools/docker2apptainer.py from borzoi/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh borzoi          # or: mkdir -p _jitcache && apptainer build [--fakeroot] borzoi.sif borzoi/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Borzoi optimization kit — Apptainer / Singularity image made FROM the container image of borzoi/environment/Dockerfile: the same stack and the
# same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged borzoi-kit:dev in the local Docker daemon (build it
# first: README.md 'Setup', route A); for a published tag the two header lines read `Bootstrap: docker` / `From: <registry>/borzoi-kit:<tag>`.
#   apptainer build borzoi.sif borzoi/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/borzoi_data:/data --bind "$PWD/out":/out borzoi.sif \
#     sad --config h100 --mode exact -f /data/hg38.ml.fa -o /out/exact --rc --stats SAD,logSAD -t /opt/borzoi/examples/targets_human.txt -u \
#     /opt/borzoi/examples/params.json /data/f0/model0_best.h5 /kit/borzoi/tests/inputs/example_snvs.vcf
# The image is read-only: give sad an -o on a bound, writable path (the stock script creates it, non-recursively, and refuses an existing one);
# %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: python:3.10.17-slim-bookworm

%files
    borzoi /.ctx/borzoi

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export TF_CPP_MIN_LOG_LEVEL="1"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y bedtools build-essential gfortran git libbz2-dev libcurl4-openssl-dev liblzma-dev libssl-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/borzoi/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
echo "build machine: $(nproc --all) cores" \
 && grep -E '^pip==' /tmp/requirements.lock | xargs python -m pip install --no-cache-dir --no-deps \
 && echo 'setuptools==84.0.0' > /tmp/build-constraints.txt \
 && grep -v -E '^(#|-e |setuptools==)' /tmp/requirements.lock > /tmp/stack.txt \
 && PIP_CONSTRAINT=/tmp/build-constraints.txt python -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt \
 && grep -E '^setuptools==' /tmp/requirements.lock | xargs python -m pip install --no-cache-dir --no-deps \
 && rm -f /tmp/stack.txt /tmp/requirements.lock
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/borzoi/stock/baskerville-544073b.tar.gz /.ctx/borzoi/stock/borzoi-5c93582.tar.gz /tmp/stock/
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
mkdir -p /opt/baskerville /opt/borzoi \
 && tar -xzf /tmp/stock/baskerville-544073b.tar.gz -C /opt/baskerville --strip-components=1 \
 && tar -xzf /tmp/stock/borzoi-5c93582.tar.gz -C /opt/borzoi --strip-components=1 \
 && chmod +x /opt/borzoi/src/scripts/*.py /opt/baskerville/src/baskerville/scripts/*.py \
 && PIP_CONSTRAINT=/tmp/build-constraints.txt \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_BASKERVILLE=1.0.0 SETUPTOOLS_SCM_PRETEND_VERSION_FOR_BORZOI=1.0.1.dev7+g5c9358222 \
    python -m pip install --no-cache-dir --no-deps -e /opt/baskerville -e /opt/borzoi \
 && rm -rf /tmp/stock /tmp/build-constraints.txt /root/.cache/pip
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    export BORZOI_DIR="/opt/borzoi"
    export BASKERVILLE_DIR="/opt/baskerville"
    export PATH="/opt/borzoi/src/scripts:/opt/baskerville/src/baskerville/scripts:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export PYTHONPATH="/opt/borzoi/src/scripts:/opt/baskerville/src/baskerville/scripts"
    _copy /.ctx/borzoi /kit/borzoi
    mkdir -p /kit/borzoi && cd /kit/borzoi
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export TF_CPP_MIN_LOG_LEVEL="1"
    export BORZOI_DIR="/opt/borzoi"
    export BASKERVILLE_DIR="/opt/baskerville"
    export PATH="/opt/borzoi/src/scripts:/opt/baskerville/src/baskerville/scripts:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    export PYTHONPATH="/opt/borzoi/src/scripts:/opt/baskerville/src/baskerville/scripts"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/borzoi && exec bash /kit/borzoi/run.sh "$@"

%help
    Borzoi optimization kit: drop-in modes that make stock Borzoi variant scoring (borzoi_sad.py of calico/borzoi @ 5c93582 on calico/baskerville
    @ 544073b, TensorFlow 2.15.1) faster without changing how it is called — off = stock exactly; exact (the default, the one kit mode) = identical
    outputs, faster. `apptainer run --nv borzoi.sif <verb> ...` =
    `bash /kit/borzoi/run.sh <verb> ...` (verbs: install, sad, check; /kit/borzoi/README.md inside the image). Requires an NVIDIA driver that
    runs CUDA 12.2 (535 or newer); the genome, targets, params and weights are the command's own arguments on bound paths.

