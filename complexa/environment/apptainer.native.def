# GENERATED by tools/docker2apptainer.py from complexa/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh complexa          # or: mkdir -p _jitcache && apptainer build [--fakeroot] complexa.sif complexa/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# Proteina-Complexa optimization kit — Apptainer / Singularity image made FROM the container image of complexa/environment/Dockerfile: the same
# stack, the same /opt/pc and /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged complexa-kit:dev in the local
# Docker daemon (build it first with complexa/environment/Dockerfile); for a published tag the two header lines read `Bootstrap: docker` /
# `From: <registry>/complexa-kit:<tag>`.
#   apptainer build complexa.sif complexa/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/complexa_weights:/weights --env CKPT_PATH=/weights --bind "$PWD/out":/out complexa.sif \
#     design --config h100 --mode off --out /out/pdl1 -- ++generation.dataloader.dataset.nres.nsamples=2
# The image is read-only: give every run an --out on a bound, writable path; the JIT caches go under $HOME/.cache (bound by default);
# %environment keeps a host user site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: python:3.12.10-slim-bookworm

%files
    common /.ctx/common
    complexa /.ctx/complexa

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update && apt-get install -y build-essential git wget gfortran libxrender1 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    _copy /.ctx/complexa/environment/requirements.lock /tmp/requirements.lock
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
grep -v '^-e ' /tmp/requirements.lock > /tmp/stack.txt \
 && { grep -E '^[A-Za-z0-9._-]+==' /tmp/stack.txt; echo 'hatchling==1.31.0'; } > /tmp/build-pins.txt \
 && grep -E '^pip==' /tmp/stack.txt | xargs python3.12 -m pip install --no-cache-dir \
 && PIP_CONSTRAINT=/tmp/build-pins.txt python3.12 -m pip install --no-cache-dir --no-deps -r /tmp/stack.txt
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/complexa/stock/proteina-complexa-916eaaed.tar.gz /tmp/stock/proteina-complexa-916eaaed.tar.gz
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
tar -xzf /tmp/stock/proteina-complexa-916eaaed.tar.gz -C /opt && mv /opt/proteina-complexa-916eaaed /opt/pc \
 && PIP_CONSTRAINT=/tmp/build-pins.txt python3.12 -m pip install --no-cache-dir --no-deps -e /opt/pc -e /opt/pc/community_models/colabdesign \
 && rm -rf /tmp/stock /tmp/stack.txt /tmp/build-pins.txt /tmp/requirements.lock
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LOCAL_CODE_PATH="/opt/pc"
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/complexa /kit/complexa
    mkdir -p /kit/complexa && cd /kit/complexa
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
bash run.sh install
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export LOCAL_CODE_PATH="/opt/pc"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/complexa && exec bash /kit/complexa/run.sh "$@"

%help
    Proteina-Complexa optimization kit: stock Proteina-Complexa 1.1.0 binder generation (upstream's `complexa generate`, the generation stage)
    behind one interface — mode off = stock exactly, with your Hydra overrides after `--`; exact / fast / big = the same command with the
    kit's levers inside upstream's process (exact, big: byte-identical designs, less memory; fast: faster still, tolerance class).
    `apptainer run --nv complexa.sif <verb> ...` = `bash /kit/complexa/run.sh <verb> ...`
    (verbs: install, design, check; /kit/complexa/README.md inside the image). Requires an NVIDIA driver that runs CUDA 12.6 (560 or newer)
    and CKPT_PATH naming the directory that holds complexa.ckpt + complexa_ae.ckpt (`run.sh install --weights DIR` fetches them).

