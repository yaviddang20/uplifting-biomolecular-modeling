# GENERATED by tools/docker2apptainer.py from af3_torch/environment/Dockerfile — native Apptainer build, no Docker daemon needed.
# Build from the repository root (the directory holding common/ and the kits):
#   bash tools/build_sif.sh af3_torch          # or: mkdir -p _jitcache && apptainer build [--fakeroot] af3_torch.sif af3_torch/environment/apptainer.native.def
# Build arguments of the Dockerfile are Apptainer build args: apptainer build --build-arg NAME=value ...
# Everything below the original header works exactly as documented for apptainer.def:
# AF3-torch optimization kit — Apptainer / Singularity image made FROM the container image of af3_torch/environment/Dockerfile: the same stack
# and the same /kit, for hosts that run Apptainer instead of Docker. The source is the image tagged af3_torch-kit:dev in the local Docker daemon
# (build it first: README.md 'Setup'); an image pushed to a registry is used with `Bootstrap: docker` and `From:` naming that image instead.
#   apptainer build af3_torch.sif af3_torch/environment/apptainer.def
#   apptainer run --nv --cleanenv --bind /path/to/params:/params --env AF3_TORCH_PARAMS_DIR=/params --bind "$PWD/out":/out --env AF3_TORCH_CACHE_ROOT=/out/cache \
#     af3_torch.sif pred --config h100 --mode fast --json_path /kit/af3_torch/inputs/1BRS.json --output_dir /out/fast
# The image is read-only: give every verb an --output_dir on a bound, writable path and point AF3_TORCH_CACHE_ROOT (the Triton / Inductor / JAX
# compile caches, /tmp/af3_torch_cache by default) at one too when you want the caches kept between runs; %environment keeps a host user
# site-packages (PEP 370) from shadowing the pinned stack, --cleanenv keeps the host's variables out.
Bootstrap: docker
From: nvidia/cuda:12.6.3-base-ubuntu24.04

%arguments
    WHEELS_FROM=build
    BUILD_JOBS=0

%files
    _jitcache /.ctx/_jitcache
    af3_torch /.ctx/af3_torch
    common /.ctx/common

%post
    # the base image's Docker ENV (PATH, CUDA vars, MAMBA_ROOT_PREFIX, ...) as a Docker RUN would see it
    [ -f /.singularity.d/env/10-docker2singularity.sh ] && . /.singularity.d/env/10-docker2singularity.sh
    export HOME=/root DEBIAN_FRONTEND=noninteractive
    cd /
    # Docker COPY semantics: a directory source copies its contents; several sources or a trailing / mean "into dst/";
    # a glob that matches nothing is skipped (the Dockerfiles use `_jitcache/x-*-jit.ta[r]` for optional files)
    _copy() {
        for _dst; do :; done; _n=$(($# - 1)); _i=0; _srcs=""
        for _a in "$@"; do _i=$((_i + 1)); [ $_i -le $_n ] || break
            for _m in $_a; do [ -e "$_m" ] && _srcs="$_srcs $_m"; done; done
        _into=0; case "$_dst" in */) _into=1;; esac; [ $_n -gt 1 ] && _into=1
        for _s in $_srcs; do
            if [ -d "$_s" ]; then mkdir -p "$_dst" && cp -a "$_s"/. "$_dst"/
            elif [ $_into = 1 ]; then mkdir -p "$_dst" && cp -a "$_s" "$_dst"/
            else mkdir -p "$(dirname "$_dst")" && cp -a "$_s" "$_dst"; fi
        done
    }
    export WHEELS_FROM="{{ WHEELS_FROM }}"
    export BUILD_JOBS="{{ BUILD_JOBS }}"
    cat > /tmp/.run1.sh <<'__DOCKER_RUN_1__'
apt-get update --quiet \
 && DEBIAN_FRONTEND=noninteractive apt-get install --yes --quiet --no-install-recommends \
      ca-certificates wget git build-essential zlib1g-dev zstd patch \
 && rm -rf /var/lib/apt/lists/*
__DOCKER_RUN_1__
    /bin/sh /tmp/.run1.sh || { echo 'RUN step 1 failed' >&2; exit 1; }; rm -f /tmp/.run1.sh
    cat > /tmp/.run2.sh <<'__DOCKER_RUN_2__'
wget -q -O /tmp/python.tgz https://github.com/indygreg/python-build-standalone/releases/download/20240107/cpython-3.12.1+20240107-x86_64_v3-unknown-linux-gnu-install_only.tar.gz \
 && echo "a7bcc6c9f66dbd47ea99615f30f101c5d2dd0084ca333d2f7336e64050951338  /tmp/python.tgz" | sha256sum -c - \
 && tar xzf /tmp/python.tgz -C /tmp && cp -a /tmp/python/. /usr/local/ && rm -rf /tmp/python /tmp/python.tgz \
 && ln -sf /usr/local/bin/python3 /usr/local/bin/python \
 && /usr/local/bin/python3 -m pip install --no-cache-dir uv==0.9.24
__DOCKER_RUN_2__
    /bin/sh /tmp/.run2.sh || { echo 'RUN step 2 failed' >&2; exit 1; }; rm -f /tmp/.run2.sh
    _copy /.ctx/af3_torch/environment/requirements-torch.lock /.ctx/af3_torch/environment/requirements-jax.lock /tmp/env/
    cat > /tmp/.run3.sh <<'__DOCKER_RUN_3__'
uv venv --python /usr/local/bin/python3.12 /torch_venv \
 && grep -v '^#' /tmp/env/requirements-torch.lock > /tmp/env/torch.txt \
 && uv pip install --no-cache --python /torch_venv/bin/python --no-deps -r /tmp/env/torch.txt
__DOCKER_RUN_3__
    /bin/sh /tmp/.run3.sh || { echo 'RUN step 3 failed' >&2; exit 1; }; rm -f /tmp/.run3.sh
    _copy /.ctx/af3_torch/stock/PINS.json /.ctx/af3_torch/stock/patches/04_of3_empty_template_restype_gap.diff /tmp/stock/
    _copy /.ctx/af3_torch/stock/wheels/ /tmp/wheels/
    cat > /tmp/.run4.sh <<'__DOCKER_RUN_4__'
uv venv --python /usr/local/bin/python3.12 --prompt alphafold3-open /alphafold3_venv \
 && grep -v -E '^(#|alphafold3-open==)' /tmp/env/requirements-jax.lock > /tmp/env/jax.txt \
 && uv pip install --no-cache --python /alphafold3_venv/bin/python --no-deps -r /tmp/env/jax.txt \
 && git clone --quiet https://github.com/sokrypton/alphafold3 /app/alphafold && cd /app/alphafold \
 && git checkout --quiet bc32b22ff5902e3daffd5d1f7203d7f2ab6cb997 && git rev-parse HEAD > COMMIT \
 && [ "$(cat COMMIT)" = bc32b22ff5902e3daffd5d1f7203d7f2ab6cb997 ] && rm -rf .git \
 && patch -p1 < /tmp/stock/04_of3_empty_template_restype_gap.diff \
 && { J="${BUILD_JOBS:-0}"; [ "$J" -gt 0 ] || J=$(nproc --all); } \
 && echo "af3_torch environment: WHEELS_FROM=$WHEELS_FROM, $J build jobs on a $(nproc --all)-core builder" \
 && if [ "$WHEELS_FROM" = build ]; then \
      export CC=gcc CXX=g++ MAX_JOBS=$J CMAKE_BUILD_PARALLEL_LEVEL=$J MAKEFLAGS=-j$J \
      && grep -E '^numpy==' /tmp/env/jax.txt > /tmp/env/build-constraints.txt \
      && uv build --wheel --no-cache --python /usr/local/bin/python3.12 --build-constraint /tmp/env/build-constraints.txt --out-dir /tmp/wheels /app/alphafold \
      && rm -rf /app/alphafold/dist /app/alphafold/build; \
    elif [ "$WHEELS_FROM" = prebuilt ]; then \
      /usr/local/bin/python3 -c 'import hashlib, json, os, sys; arts = json.load(open("/tmp/stock/PINS.json"))["reference"]["artefacts"]["files"]; bad = [a["file"] for a in arts if not os.path.isfile("/tmp/wheels/" + a["file"]) or hashlib.sha256(open("/tmp/wheels/" + a["file"], "rb").read()).hexdigest() != a["sha256"]]; print("af3_torch/stock/wheels: " + (("MISSING OR NOT THE PINNED BYTES: " + ", ".join(bad)) if bad else "%d files match stock/PINS.json reference.artefacts" % len(arts))); sys.exit(65 if bad else 0)'; \
    else echo "WHEELS_FROM must be build or prebuilt, not '$WHEELS_FROM'"; exit 64; fi \
 && uv pip install --no-cache --python /alphafold3_venv/bin/python --no-deps /tmp/wheels/alphafold3_open-3.1.4-cp312-cp312-linux_x86_64.whl \
 && if [ "$WHEELS_FROM" = build ]; then /alphafold3_venv/bin/build_data; \
    else tar xzf /tmp/wheels/alphafold3-build_data.tar.gz -C /alphafold3_venv/lib/python3.12/site-packages; fi \
 && ls -l /alphafold3_venv/lib/python3.12/site-packages/alphafold3/constants/converters/ccd.pickle \
 && rm -rf /tmp/wheels /tmp/stock /tmp/env /root/.cache
__DOCKER_RUN_4__
    /bin/sh /tmp/.run4.sh || { echo 'RUN step 4 failed' >&2; exit 1; }; rm -f /tmp/.run4.sh
    export PATH="/kit/venv/bin:/alphafold3_venv/bin:${PATH}"
    export AF3_TORCH_PY="/torch_venv/bin/python"
    export AF3_TORCH_JAX_PY="/alphafold3_venv/bin/python"
    export AF3_TORCH_JAX_REPO="/app/alphafold"
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_PYTHON_CLIENT_PREALLOCATE="true"
    export XLA_CLIENT_MEM_FRACTION="0.95"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    _copy /.ctx/common/opt_core /kit/common/opt_core
    _copy /.ctx/af3_torch /kit/af3_torch
    mkdir -p /kit/af3_torch && cd /kit/af3_torch
    cat > /tmp/.run5.sh <<'__DOCKER_RUN_5__'
uv venv --seed --python /usr/local/bin/python3.12 /kit/venv && bash run.sh install
__DOCKER_RUN_5__
    /bin/sh /tmp/.run5.sh || { echo 'RUN step 5 failed' >&2; exit 1; }; rm -f /tmp/.run5.sh
    _copy /.ctx/af3_torch/environment/Dockerfile /.ctx/_jitcache/af3_torch-*-jit.ta[r] /tmp/jit/
    cat > /tmp/.run6.sh <<'__DOCKER_RUN_6__'
set -e; mkdir -p /opt/jit_cache; \
    for t in /tmp/jit/*-jit.tar; do [ -f "$t" ] && tar -xf "$t" -C /opt/jit_cache; done; \
    chmod -R a+rX,u+w /opt/jit_cache; rm -rf /tmp/jit
__DOCKER_RUN_6__
    /bin/sh /tmp/.run6.sh || { echo 'RUN step 6 failed' >&2; exit 1; }; rm -f /tmp/.run6.sh
    cat > /tmp/.run7.sh <<'__DOCKER_RUN_7__'
mkdir -p /torch_venv/share && ln -s /opt/jit_cache /torch_venv/share/af3_torch_cache
__DOCKER_RUN_7__
    /bin/sh /tmp/.run7.sh || { echo 'RUN step 7 failed' >&2; exit 1; }; rm -f /tmp/.run7.sh
    cd / && rm -rf /.ctx
    # --- from the original apptainer.def
    mkdir -p /opt/culib && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so && ln -s /.singularity.d/libs/libcuda.so.1 /opt/culib/libcuda.so.1

%environment
    export PATH="/kit/venv/bin:/alphafold3_venv/bin:${PATH}"
    export AF3_TORCH_PY="/torch_venv/bin/python"
    export AF3_TORCH_JAX_PY="/alphafold3_venv/bin/python"
    export AF3_TORCH_JAX_REPO="/app/alphafold"
    export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false"
    export XLA_PYTHON_CLIENT_PREALLOCATE="true"
    export XLA_CLIENT_MEM_FRACTION="0.95"
    export PYTHONHASHSEED="0"
    export CFLAGS="-g0"
    export PYTHONNOUSERSITE=1
    # Triton <= 3.5 links its launcher stub with -lcuda: offer the unversioned name when --nv bound only libcuda.so.1
    if [ -z "${TRITON_LIBCUDA_PATH:-}" ] && [ -e /opt/culib/libcuda.so ]; then export TRITON_LIBCUDA_PATH=/opt/culib; fi

%runscript
    cd /kit/af3_torch && exec bash /kit/af3_torch/run.sh "$@"

%help
    AF3-torch optimization kit: drop-in modes that make stock xfold (a PyTorch re-implementation of the AlphaFold 3 forward pass, run on the
    converted OpenFold3-preview2 weights) faster or lighter on GPU memory without changing how it is called — off = stock exactly; exact =
    identical outputs, faster; fast = small documented numeric differences, faster still (the default); big = lowest memory for large inputs.
    `apptainer run --nv af3_torch.sif <verb> ...` = `bash /kit/af3_torch/run.sh <verb> ...` (verbs: install, pred, check, stock;
    /kit/af3_torch/README.md inside the image). Requires an NVIDIA driver that runs CUDA 13.0 (580 or newer) and AF3_TORCH_PARAMS_DIR naming
    the directory that holds the converted checkpoint (of3_ported_weights.bin.zst).

